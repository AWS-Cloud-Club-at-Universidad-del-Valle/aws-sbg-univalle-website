# URL base de la API de Eventos (endpoints GET públicos, sin autenticación).
#
# Producción: https://4fi9ot44ml.execute-api.us-east-1.amazonaws.com/prod
# Desarrollo:  https://orj83oh0pc.execute-api.us-east-1.amazonaws.com/dev
#
# El prefijo PUBLIC_ es requerido por Astro para exponer la variable al cliente.
PUBLIC_EVENTS_API_URL=https://4fi9ot44ml.execute-api.us-east-1.amazonaws.com/prod

# ------------------------------------------------------------
# CDN de assets (imágenes servidas por CloudFront → bucket S3 privado).
#
# Producción (main):
#   PUBLIC_ASSETS_CDN_URL=https://d2zjot7yvduv1u.cloudfront.net
#   PUBLIC_ASSETS_MEMBERS_PATH=members
#   PUBLIC_ASSETS_LOGOS_PATH=prod-assets/prod-logos
#
# Desarrollo (develop):
#   PUBLIC_ASSETS_CDN_URL=https://d23d5d88jw9p2.cloudfront.net
#   PUBLIC_ASSETS_MEMBERS_PATH=dev-members/photos-members
#   PUBLIC_ASSETS_LOGOS_PATH=dev-assets/dev-logos
#
# El workflow de deploy inyecta estos valores según la rama.
# Si no se definen, el código usa producción por defecto.
PUBLIC_ASSETS_CDN_URL=https://d2zjot7yvduv1u.cloudfront.net
PUBLIC_ASSETS_MEMBERS_PATH=members
PUBLIC_ASSETS_LOGOS_PATH=prod-assets/prod-logos
