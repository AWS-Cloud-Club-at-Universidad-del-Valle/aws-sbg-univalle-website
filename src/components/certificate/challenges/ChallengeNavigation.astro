---
/**
 * ChallengeNavigation — Breadcrumb + botones anterior/siguiente reto.
 */
interface ChallengeRef {
  slug: string;
  title: string;
  id: number;
}
interface Props {
  current: ChallengeRef;
  prev?: ChallengeRef;
  next?: ChallengeRef;
}
const { current, prev, next } = Astro.props;
---

<!-- Breadcrumb -->
<nav aria-label="Breadcrumb" class="ch-breadcrumb">
  <ol class="ch-breadcrumb__list">
    <li>
      <a href="/certificate" class="ch-breadcrumb__link">Certifícate</a>
      <span aria-hidden="true" class="ch-breadcrumb__sep">›</span>
    </li>
    <li>
      <a href="/certificate/challenges" class="ch-breadcrumb__link">Retos</a>
      <span aria-hidden="true" class="ch-breadcrumb__sep">›</span>
    </li>
    <li aria-current="page" class="ch-breadcrumb__current">
      Reto {current.id}
    </li>
  </ol>
</nav>

<!-- Navegación anterior / siguiente -->
<nav aria-label="Navegación entre retos" class="ch-nav-pager">
  <div class="ch-nav-pager__inner">
    {prev ? (
      <a href={`/certificate/challenges/${prev.slug}`} class="ch-nav-pager__btn ch-nav-pager__btn--prev">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        <span>
          <span class="ch-nav-pager__label">Reto anterior</span>
          <span class="ch-nav-pager__name">Reto {prev.id} — {prev.title}</span>
        </span>
      </a>
    ) : (
      <div />
    )}

    {next ? (
      <a href={`/certificate/challenges/${next.slug}`} class="ch-nav-pager__btn ch-nav-pager__btn--next">
        <span>
          <span class="ch-nav-pager__label">Reto siguiente</span>
          <span class="ch-nav-pager__name">Reto {next.id} — {next.title}</span>
        </span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </a>
    ) : (
      <div />
    )}
  </div>
</nav>
