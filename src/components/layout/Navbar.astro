---
/**
 * Navbar — Sidebar vertical izquierdo fijo con diseño premium.
 * Desktop: 220px fijo, con visual atractivo que invita a explorar.
 * Mobile: hidden por defecto, toggle hamburger en top bar.
 */
import { NAV_LINKS, SITE_CONFIG } from '@/lib/constants';

interface Props { class?: string; }
const { class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;

// Icons for each nav link
const navIcons: Record<string, string> = {
  '/': `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  '/about': `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  '/certificate': `<circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>`,
  '/events': `<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  '/resources': `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  '/participate': `<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>`,
  '/contact': `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`,
};
---

<!-- ── Top bar mobile (solo < 1024px) ── -->
<div class="fixed top-0 left-0 right-0 z-40 flex h-14 items-center justify-between border-b border-[var(--sbg-border)] bg-[var(--sbg-sidebar-bg)]/95 backdrop-blur-md px-4 lg:hidden">
  <a href="/" aria-label="AWS SBG Univalle" class="flex items-center gap-2.5">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg overflow-hidden bg-[var(--sbg-bg-elevated)] shadow-md shadow-[rgba(255,153,0,0.15)]">
      <img
        src="https://d2zjot7yvduv1u.cloudfront.net/logos/logo_aws_sbg_univalle.jpeg"
        alt="Logo AWS SBG Univalle"
        class="h-full w-full object-cover"
        loading="eager"
      />
    </div>
    <div>
      <span class="font-mono text-[11px] font-bold text-[var(--sbg-text)] block leading-none">AWS SBG</span>
      <span class="font-mono text-[8px] text-[var(--sbg-orange)] block mt-0.5">Univalle</span>
    </div>
  </a>
  <button id="mob-toggle" type="button" aria-expanded="false" aria-label="Abrir menú"
    class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--sbg-text-muted)] hover:bg-[var(--sbg-bg-elevated)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]">
    <svg id="mob-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
    <svg id="mob-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<!-- ── Sidebar ── -->
<aside
  id="sidebar"
  class:list={[
    'fixed top-14 lg:top-0 left-0 z-30 h-[calc(100vh-3.5rem)] lg:h-screen w-[220px]',
    'flex flex-col border-r border-[var(--sbg-border)] bg-[var(--sbg-sidebar-bg)]',
    'transition-transform duration-300 ease-out',
    '-translate-x-full lg:translate-x-0',
    'overflow-hidden',
    className,
  ]}
  aria-label="Navegación principal"
>
  <!-- Animated background gradient mesh -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Top corner glow -->
    <div class="absolute -top-20 -right-20 w-40 h-40 rounded-full opacity-20"
         style="background: radial-gradient(circle, var(--sbg-orange) 0%, transparent 70%);
                animation: float-circle 10s ease-in-out infinite;"></div>
    <!-- Bottom corner glow -->
    <div class="absolute -bottom-16 -left-16 w-32 h-32 rounded-full opacity-15"
         style="background: radial-gradient(circle, var(--sbg-accent) 0%, transparent 70%);
                animation: float-circle 8s ease-in-out infinite 3s;"></div>
    <!-- Center ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 rounded-full opacity-[0.04]"
         style="background: radial-gradient(circle, var(--sbg-accent-light) 0%, transparent 70%);"></div>
    <!-- Subtle noise/grid texture -->
    <div class="absolute inset-0 opacity-[0.015]"
         style="background-image: radial-gradient(circle, #fff 0.5px, transparent 0.5px); background-size: 20px 20px;"></div>
  </div>

  <!-- Logo (solo desktop, en mobile ya está en la top bar) -->
  <div class="relative border-b border-[var(--sbg-border)] px-4 py-5 hidden lg:block">
    <a href="/" class="flex flex-col items-center gap-2 group focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded-lg" aria-label="AWS SBG Univalle - Inicio">
      <div class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full transition-all duration-300 group-hover:scale-105">
        <img
          src="https://d2zjot7yvduv1u.cloudfront.net/logos/logo_aws_sbg_univalle.jpeg"
          alt="Logo AWS SBG Univalle"
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
      <p class="font-mono text-[10px] font-bold leading-tight text-[var(--sbg-text-muted)] text-center tracking-wide">AWS SBG Univalle</p>
    </a>
  </div>

  <!-- Navigation -->
  <div class="relative px-4 pt-5 pb-1.5">
    <span class="code-label text-[9px]"># navegación</span>
  </div>

  <nav aria-label="Menú principal" class="relative flex-1 overflow-y-auto px-3">
    <ul role="list" class="space-y-0.5">
      {NAV_LINKS.map(({ href, label }) => {
        const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
        const icon = navIcons[href] || navIcons['/'];
        return (
          <li>
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'sidebar-link group relative flex items-center gap-3 rounded-xl px-3.5 py-2.5',
                'text-[13px] transition-all duration-200 overflow-hidden',
                'focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded-xl',
                isActive
                  ? 'bg-gradient-to-r from-[var(--sbg-orange)]/10 to-[var(--sbg-accent)]/10 text-white font-semibold border border-[var(--sbg-orange)]/20'
                  : 'text-[var(--sbg-text-muted)] hover:text-white',
              ]}
              style="font-family:'Nunito Sans',sans-serif;"
            >
              <!-- Icon -->
              <span class:list={[
                'flex h-7 w-7 shrink-0 items-center justify-center rounded-lg transition-all duration-200',
                isActive
                  ? 'bg-gradient-to-br from-[var(--sbg-orange)] to-[var(--sbg-accent)] text-white shadow-md shadow-[var(--sbg-orange)]/20'
                  : 'bg-[var(--sbg-bg-elevated)] text-[var(--sbg-text-subtle)] group-hover:bg-[var(--sbg-orange)]/15 group-hover:text-[var(--sbg-orange)]',
              ]}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <Fragment set:html={icon} />
                </svg>
              </span>
              
              <span class="relative z-10">{label}</span>

              <!-- Active arrow indicator -->
              {isActive && (
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="ml-auto text-[var(--sbg-orange)] opacity-70">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              )}
              
              <!-- Hover glow background -->
              <span class="absolute inset-0 rounded-xl bg-gradient-to-r from-[var(--sbg-orange)]/5 to-[var(--sbg-accent)]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Social links -->
  <div class="relative border-t border-[var(--sbg-border)] px-4 py-3.5">
    <div class="flex items-center justify-between">
      <span class="code-label text-[8px]"># social</span>
      <div class="flex items-center gap-0.5">
        {[
          { href: SITE_CONFIG.social.instagram, label: 'Instagram', icon: `<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>` },
          { href: SITE_CONFIG.social.linkedin, label: 'LinkedIn', icon: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>` },
          { href: SITE_CONFIG.social.github, label: 'GitHub', icon: `<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>` },
          { href: SITE_CONFIG.social.whatsapp, label: 'WhatsApp', icon: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>` },
          { href: SITE_CONFIG.social.youtube, label: 'YouTube', icon: `<polygon points="5 3 19 12 5 21 5 3"/>` },
        ].filter(s => s.href).map(({ href, label, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="flex h-7 w-7 items-center justify-center rounded-md text-[var(--sbg-text-subtle)] transition-all duration-200 hover:bg-[var(--sbg-bg-elevated)] hover:text-[var(--sbg-orange)] hover:scale-110 focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <Fragment set:html={icon} />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</aside>

<!-- Overlay mobile -->
<div id="mob-overlay" aria-hidden="true"
  class="fixed inset-0 z-20 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

<script is:inline>
document.addEventListener('astro:page-load', function() {
  var toggle   = document.getElementById('mob-toggle');
  var sidebar  = document.getElementById('sidebar');
  var overlay  = document.getElementById('mob-overlay');
  var iconOpen = document.getElementById('mob-icon-open');
  var iconClose= document.getElementById('mob-icon-close');
  if (!toggle || !sidebar || !overlay) return;

  function open() {
    sidebar.classList.remove('-translate-x-full');
    sidebar.classList.add('translate-x-0');
    overlay.classList.remove('opacity-0','pointer-events-none');
    overlay.classList.add('opacity-100');
    toggle.setAttribute('aria-expanded','true');
    document.body.style.overflow = 'hidden';
    if (iconOpen) iconOpen.classList.add('hidden');
    if (iconClose) iconClose.classList.remove('hidden');
  }
  function close() {
    sidebar.classList.add('-translate-x-full');
    sidebar.classList.remove('translate-x-0');
    overlay.classList.add('opacity-0','pointer-events-none');
    overlay.classList.remove('opacity-100');
    toggle.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
    if (iconOpen) iconOpen.classList.remove('hidden');
    if (iconClose) iconClose.classList.add('hidden');
  }

  toggle.addEventListener('click', function() {
    toggle.getAttribute('aria-expanded') === 'true' ? close() : open();
  });
  overlay.addEventListener('click', close);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') close(); });
  sidebar.querySelectorAll('a').forEach(function(a) {
    a.addEventListener('click', function() {
      if (window.innerWidth < 1024) close();
    });
  });
  window.matchMedia('(min-width:1024px)').addEventListener('change', function(e) { if (e.matches) close(); });
});
</script>
