---
/**
 * Navbar — Sidebar vertical izquierdo fijo.
 * Desktop: 220px fijo a la izquierda, logo + nav + CTA + redes.
 * Mobile: hidden por defecto, toggle hamburger en top bar.
 */
import { NAV_LINKS, SITE_CONFIG } from '@/lib/constants';

interface Props { class?: string; }
const { class: className = '' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!-- ── Top bar mobile (solo < 1024px) ── -->
<div class="fixed top-0 left-0 right-0 z-40 flex h-14 items-center justify-between border-b border-[var(--sbg-border)] bg-[var(--sbg-sidebar-bg)]/95 backdrop-blur-md px-4 lg:hidden">
  <a href="/" aria-label="AWS SBG Univalle" class="flex items-center gap-2.5">
    <div class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--sbg-accent)]">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M3 17L7 7L11 14L15 10L19 17"/>
      </svg>
    </div>
    <span class="font-mono text-xs font-bold text-[var(--sbg-text)]">AWS SBG</span>
  </a>
  <button id="mob-toggle" type="button" aria-expanded="false" aria-label="Abrir menú"
    class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--sbg-text-muted)] hover:bg-[var(--sbg-bg-elevated)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]">
    <svg id="mob-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
    <svg id="mob-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<!-- ── Sidebar ── -->
<aside
  id="sidebar"
  class:list={[
    'fixed top-0 left-0 z-30 h-screen w-[220px]',
    'flex flex-col border-r border-[var(--sbg-border)] bg-[var(--sbg-sidebar-bg)]',
    'transition-transform duration-300 ease-out',
    '-translate-x-full lg:translate-x-0',
    'overflow-hidden', // Para floating elements
    className,
  ]}
  aria-label="Navegación principal"
>
  <!-- Floating geometric elements -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
    <!-- Floating triangle -->
    <div class="absolute -top-4 -right-6 w-12 h-12 opacity-20"
         style="background: linear-gradient(135deg, var(--sbg-accent) 0%, var(--sbg-orange) 100%); 
                clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
                animation: float-triangle 8s ease-in-out infinite;"></div>
    
    <!-- Floating square -->
    <div class="absolute top-1/3 -left-3 w-8 h-8 opacity-15"
         style="background: linear-gradient(45deg, var(--sbg-orange) 0%, var(--sbg-accent) 100%);
                animation: float-square 6s ease-in-out infinite 1s;"></div>
    
    <!-- Floating circle -->
    <div class="absolute bottom-1/4 -right-4 w-10 h-10 opacity-25 rounded-full"
         style="background: radial-gradient(circle, var(--sbg-accent) 0%, transparent 70%);
                animation: float-circle 7s ease-in-out infinite 2s;"></div>
    
    <!-- Floating rhombus -->
    <div class="absolute bottom-12 left-3 w-6 h-6 opacity-20"
         style="background: linear-gradient(90deg, var(--sbg-orange) 0%, var(--sbg-accent) 100%);
                animation: float-rhombus 5s ease-in-out infinite 0.5s;"></div>
    
    <!-- Subtle gradient overlay -->
    <div class="absolute inset-0 opacity-30"
         style="background: linear-gradient(180deg, 
                rgba(220,20,60,0.03) 0%, 
                transparent 40%, 
                transparent 60%, 
                rgba(255,153,0,0.02) 100%);"></div>
  </div>

  <!-- Logo with enhanced styling -->
  <div class="relative flex items-center gap-3 border-b border-[var(--sbg-border)] px-5 py-5">
    <!-- Background glow -->
    <div class="absolute inset-0 opacity-60"
         style="background: radial-gradient(ellipse at center left, 
                rgba(220,20,60,0.05) 0%, 
                transparent 70%);"></div>
    
    <div class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[var(--sbg-accent)] to-[var(--sbg-accent-hover)] shadow-lg shadow-[rgba(220,20,60,0.35)]">
      <!-- AWS cloud icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
        <polyline points="13 11 9 17 11 17"/>
      </svg>
    </div>
    <div class="relative">
      <p class="font-mono text-[12px] font-bold leading-none text-[var(--sbg-text)] tracking-wide">AWS SBG</p>
      <p class="mt-1 font-mono text-[9px] text-[var(--sbg-accent-light)] opacity-80 tracking-wider">Univalle</p>
    </div>
  </div>

  <!-- Nav label with enhanced styling -->
  <div class="relative px-5 pt-6 pb-3">
    <span class="code-label text-[9px] relative z-10"># navigation</span>
    <!-- Decorative line -->
    <div class="absolute left-5 bottom-1 w-12 h-0.5 bg-gradient-to-r from-[var(--sbg-accent-light)] to-transparent opacity-40"></div>
  </div>

  <!-- Enhanced Links -->
  <nav aria-label="Menú principal" class="relative flex-1 overflow-y-auto px-3">
    <ul role="list" class="space-y-1">
      {NAV_LINKS.map(({ href, label }) => {
        const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
        return (
          <li>
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'group relative flex items-center gap-3 rounded-xl px-4 py-3',
                'text-sm transition-all duration-200 overflow-hidden',
                'focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded-xl',
                isActive
                  ? 'bg-gradient-to-r from-[var(--sbg-accent-subtle)] to-[var(--sbg-orange-subtle)] text-[var(--sbg-accent-light)] font-semibold border border-[var(--sbg-accent-border)]'
                  : 'text-[var(--sbg-text-muted)] hover:bg-gradient-to-r hover:from-[var(--sbg-bg-elevated)] hover:to-[var(--sbg-bg-surface)] hover:text-[var(--sbg-text)]',
              ]}
              style="font-family:'Nunito Sans',sans-serif;"
            >
              <!-- Enhanced active indicator -->
              <span
                class:list={[
                  'relative h-5 w-1 rounded-full transition-all duration-200 shrink-0',
                  isActive 
                    ? 'bg-gradient-to-b from-[var(--sbg-accent-light)] to-[var(--sbg-accent)] shadow-lg shadow-[var(--sbg-accent)]/30' 
                    : 'bg-transparent group-hover:bg-[var(--sbg-border-accent)]',
                ]}
                aria-hidden="true"
              >
                {isActive && (
                  <span class="absolute inset-0 bg-gradient-to-b from-[var(--sbg-accent-light)] to-[var(--sbg-accent)] rounded-full animate-pulse opacity-60"></span>
                )}
              </span>
              
              <span class="relative z-10">{label}</span>
              
              <!-- Subtle hover effect background -->
              {!isActive && (
                <span class="absolute inset-0 bg-gradient-to-r from-transparent via-[var(--sbg-accent)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200" aria-hidden="true"></span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Enhanced CTA section -->
  <div class="relative border-t border-[var(--sbg-border)] p-4">
    <!-- Background glow -->
    <div class="absolute inset-0 opacity-40"
         style="background: radial-gradient(ellipse at center, 
                rgba(220,20,60,0.04) 0%, 
                transparent 80%);"></div>
    
    <a
      href="/#cta"
      class="relative flex w-full items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-[var(--sbg-accent)] to-[var(--sbg-accent-hover)] px-4 py-3 font-mono text-[11px] font-bold text-white shadow-xl shadow-[rgba(220,20,60,0.3)] transition-all duration-200 hover:shadow-2xl hover:shadow-[rgba(220,20,60,0.4)] hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-white overflow-hidden group"
    >
      <!-- Animated background shimmer -->
      <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-1000" aria-hidden="true"></span>
      
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="relative z-10">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <line x1="19" y1="8" x2="19" y2="14"/>
        <line x1="22" y1="11" x2="16" y2="11"/>
      </svg>
      <span class="relative z-10">Join now</span>
    </a>

    <!-- Enhanced social links -->
    <div class="relative mt-4 flex items-center justify-center gap-1">
      {[
        { href: SITE_CONFIG.social.linkedin, label: 'LinkedIn', path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z M2 9h4v12H2z M4 4a2 2 0 1 0 0 4 2 2 0 0 0 0-4z' },
        { href: SITE_CONFIG.social.github,   label: 'GitHub',   path: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22' },
        { href: SITE_CONFIG.social.instagram,label: 'Instagram',path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V9h4v2.4A6 6 0 0 1 16 8z M2 9h4v12H2z' },
      ].filter(s => s.href).map(({ href, label, path }) => (
        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label}
          class="relative flex h-9 w-9 items-center justify-center rounded-lg text-[var(--sbg-text-subtle)] transition-all duration-200 hover:bg-[var(--sbg-bg-elevated)] hover:text-[var(--sbg-accent-light)] hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] group overflow-hidden">
          <!-- Hover background -->
          <span class="absolute inset-0 bg-gradient-to-br from-[var(--sbg-accent)]/10 to-[var(--sbg-orange)]/10 opacity-0 group-hover:opacity-100 transition-opacity duration-200" aria-hidden="true"></span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="relative z-10">
            <path d={path}/>
          </svg>
        </a>
      ))}
    </div>
  </div>
</aside>

<!-- Overlay mobile -->
<div id="mob-overlay" aria-hidden="true"
  class="fixed inset-0 z-20 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

<script is:inline>
(function() {
  const toggle   = document.getElementById('mob-toggle');
  const sidebar  = document.getElementById('sidebar');
  const overlay  = document.getElementById('mob-overlay');
  const iconOpen = document.getElementById('mob-icon-open');
  const iconClose= document.getElementById('mob-icon-close');
  if (!toggle || !sidebar || !overlay) return;

  function open() {
    sidebar.classList.remove('-translate-x-full');
    sidebar.classList.add('translate-x-0');
    overlay.classList.remove('opacity-0','pointer-events-none');
    overlay.classList.add('opacity-100');
    toggle.setAttribute('aria-expanded','true');
    document.body.style.overflow = 'hidden';
    iconOpen.classList.add('hidden');
    iconClose.classList.remove('hidden');
  }
  function close() {
    sidebar.classList.add('-translate-x-full');
    sidebar.classList.remove('translate-x-0');
    overlay.classList.add('opacity-0','pointer-events-none');
    overlay.classList.remove('opacity-100');
    toggle.setAttribute('aria-expanded','false');
    document.body.style.overflow = '';
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');
    toggle.focus();
  }

  toggle.addEventListener('click', () =>
    toggle.getAttribute('aria-expanded') === 'true' ? close() : open());
  overlay.addEventListener('click', close);
  document.addEventListener('keydown', e => e.key === 'Escape' && close());
  sidebar.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    if (window.innerWidth < 1024) close();
  }));
  window.matchMedia('(min-width:1024px)').addEventListener('change', e => { if (e.matches) close(); });
})();
</script>
