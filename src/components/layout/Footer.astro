---
/**
 * Footer — Pie de página del sitio AWS SBG Univalle.
 *
 * Estructura (4 columnas desktop, apiladas mobile):
 * 1. Columna brand: logo, descripción, redes sociales
 * 2. Columna navegación: links principales
 * 3. Columna recursos: links rápidos a AWS
 * 4. Columna contacto: email y ubicación
 *
 * Accesibilidad:
 * - Elemento semántico <footer role="contentinfo">
 * - Todos los links externos con rel="noopener noreferrer"
 * - Iconos decorativos con aria-hidden="true"
 * - Links de redes con aria-label descriptivo
 */

import { SITE_CONFIG, NAV_LINKS } from '@/lib/constants';

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    key: 'instagram',
    label: 'Instagram de AWS SBG Univalle',
    href: SITE_CONFIG.social.instagram,
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    key: 'linkedin',
    label: 'LinkedIn de AWS SBG Univalle',
    href: SITE_CONFIG.social.linkedin,
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    key: 'github',
    label: 'GitHub de AWS SBG Univalle',
    href: SITE_CONFIG.social.github,
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    key: 'whatsapp',
    label: 'WhatsApp de AWS SBG Univalle',
    href: SITE_CONFIG.social.whatsapp,
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  },
].filter(({ href }) => Boolean(href));

const quickResources = [
  { href: 'https://aws.amazon.com/free/', label: 'AWS Free Tier' },
  { href: 'https://skillbuilder.aws/', label: 'AWS Skill Builder' },
  { href: 'https://docs.aws.amazon.com/', label: 'Documentación AWS' },
  { href: 'https://aws.amazon.com/certification/', label: 'Certificaciones AWS' },
];
---

<footer
  role="contentinfo"
  class="border-t border-[var(--sbg-border)] bg-[var(--sbg-aws-dark)] text-white"
>
  <!-- Contenido principal del footer -->
  <div class="container-sbg py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">

      <!-- Columna 1: Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <!-- Logo -->
        <a
          href="/"
          aria-label={`${SITE_CONFIG.shortName} — Página principal`}
          class="inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-2 focus-visible:rounded"
        >
          <svg
            width="36"
            height="36"
            viewBox="0 0 32 32"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="32" height="32" rx="6" fill="#FF9900" />
            <path
              d="M8 22L12 10L16 18L20 13L24 22"
              stroke="#232F3E"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="font-display text-base font-bold text-white">
            AWS SBG Univalle
          </span>
        </a>

        <p class="mt-4 text-sm leading-relaxed text-white/70">
          {SITE_CONFIG.description}
        </p>

        <!-- Redes sociales -->
        <div class="mt-6 flex items-center gap-3" role="list" aria-label="Redes sociales">
          {
            socialLinks.map(({ href, label, icon }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                role="listitem"
                class:list={[
                  'flex items-center justify-center rounded-lg',
                  'min-h-[44px] min-w-[44px] text-white/60',
                  'transition-colors duration-150 hover:text-[var(--sbg-accent)] hover:bg-white/10',
                  'focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-2',
                ]}
              >
                <Fragment set:html={icon} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-white/50">
          Navegación
        </h2>
        <ul class="mt-4 space-y-2" role="list">
          {
            NAV_LINKS.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class:list={[
                    'text-sm text-white/70 transition-colors duration-150',
                    'hover:text-white hover:underline underline-offset-4',
                    'focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-2 focus-visible:rounded',
                  ]}
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Recursos rápidos -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-white/50">
          Recursos AWS
        </h2>
        <ul class="mt-4 space-y-2" role="list">
          {
            quickResources.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    'text-sm text-white/70 transition-colors duration-150',
                    'hover:text-white hover:underline underline-offset-4',
                    'focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-2 focus-visible:rounded',
                    'inline-flex items-center gap-1',
                  ]}
                >
                  {label}
                  <!-- Icono de enlace externo -->
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                    class="opacity-60"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  <span class="sr-only">(abre en nueva pestaña)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 4: Contacto -->
      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-white/50">
          Contacto
        </h2>
        <ul class="mt-4 space-y-3" role="list">
          <li class="flex items-start gap-2 text-sm text-white/70">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              class="mt-0.5 shrink-0 text-[var(--sbg-accent)]"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>
              Universidad del Valle<br />
              Cali, Colombia
            </span>
          </li>
          <li>
            <a
              href={`mailto:contacto@sbg.univalle.edu.co`}
              class:list={[
                'inline-flex items-center gap-2 text-sm text-white/70',
                'transition-colors duration-150 hover:text-white hover:underline underline-offset-4',
                'focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-2 focus-visible:rounded',
              ]}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
                class="shrink-0 text-[var(--sbg-accent)]"
              >
                <path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                />
                <polyline points="22,6 12,13 2,6" />
              </svg>
              contacto@sbg.univalle.edu.co
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Barra inferior: copyright -->
  <div class="border-t border-white/10">
    <div
      class="container-sbg flex flex-col items-center justify-between gap-3 py-6 text-xs text-white/40 sm:flex-row"
    >
      <p>
        &copy; {currentYear} {SITE_CONFIG.name}. Todos los derechos reservados.
      </p>
      <p>
        Construido con
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/60 hover:text-white underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded"
        >
          Astro
          <span class="sr-only">(abre en nueva pestaña)</span>
        </a>
        &amp; desplegado en
        <a
          href="https://aws.amazon.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/60 hover:text-white underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded"
        >
          AWS
          <span class="sr-only">(abre en nueva pestaña)</span>
        </a>
      </p>
    </div>
  </div>
</footer>
