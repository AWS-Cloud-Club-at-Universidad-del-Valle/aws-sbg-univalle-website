---
/**
 * Footer — Pie de página AWS SBG Univalle.
 * Dark theme consistente, 4 columnas desktop, apilado mobile.
 */

import { SITE_CONFIG, NAV_LINKS } from '@/lib/constants';

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    key: 'instagram',
    label: 'Instagram de AWS SBG Univalle',
    href: SITE_CONFIG.social.instagram,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
  {
    key: 'linkedin',
    label: 'LinkedIn de AWS SBG Univalle',
    href: SITE_CONFIG.social.linkedin,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>`,
  },
  {
    key: 'github',
    label: 'GitHub de AWS SBG Univalle',
    href: SITE_CONFIG.social.github,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    key: 'whatsapp',
    label: 'WhatsApp de AWS SBG Univalle',
    href: SITE_CONFIG.social.whatsapp,
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
  },
].filter(({ href }) => Boolean(href));

const quickResources = [
  { href: 'https://aws.amazon.com/free/',           label: 'AWS Free Tier' },
  { href: 'https://skillbuilder.aws/',              label: 'AWS Skill Builder' },
  { href: 'https://docs.aws.amazon.com/',           label: 'Documentación AWS' },
  { href: 'https://aws.amazon.com/certification/',  label: 'Certificaciones AWS' },
];
---

<footer role="contentinfo" class="border-t border-[var(--sbg-border)] bg-[var(--sbg-footer-bg)]">
  <!-- Contenido principal -->
  <div class="container-sbg py-14 lg:py-20">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">

      <!-- Col 1: Brand -->
      <div class="sm:col-span-2 lg:col-span-1">

        <a
          href="/"
          aria-label={`${SITE_CONFIG.shortName} — Página principal`}
          class="inline-flex items-center gap-3 focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded-lg"
        >
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--sbg-accent)] shadow-md shadow-[rgba(255,153,0,0.2)]">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M3 17L7 7L11 14L15 10L19 17" stroke="#0d0d0d" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <span class="block text-sm font-black leading-none text-white">AWS SBG</span>
            <span class="block text-[10px] font-semibold uppercase tracking-widest text-[var(--sbg-accent)]/70 mt-0.5">Univalle</span>
          </div>
        </a>

        <p class="mt-5 text-sm leading-relaxed text-[var(--sbg-text-muted)]">
          {SITE_CONFIG.description}
        </p>

        <!-- Redes sociales -->
        <div class="mt-6 flex items-center gap-1" role="list" aria-label="Redes sociales">
          {socialLinks.map(({ href, label, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              role="listitem"
              class="flex h-9 w-9 items-center justify-center rounded-lg text-[var(--sbg-text-subtle)] transition-all duration-150 hover:bg-[var(--sbg-accent-subtle)] hover:text-[var(--sbg-accent)] focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]"
            >
              <Fragment set:html={icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Col 2: Navegación -->
      <div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.1em] text-[var(--sbg-text-subtle)]">
          Navegación
        </h2>
        <ul class="mt-4 space-y-2.5" role="list">
          {NAV_LINKS.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-sm text-[var(--sbg-text-muted)] transition-colors duration-150 hover:text-white focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Recursos AWS -->
      <div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.1em] text-[var(--sbg-text-subtle)]">
          Recursos AWS
        </h2>
        <ul class="mt-4 space-y-2.5" role="list">
          {quickResources.map(({ href, label }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm text-[var(--sbg-text-muted)] transition-colors duration-150 hover:text-white focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded"
              >
                {label}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="opacity-40">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15 3 21 3 21 9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
                <span class="sr-only">(abre en nueva pestaña)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contacto -->
      <div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.1em] text-[var(--sbg-text-subtle)]">
          Contacto
        </h2>
        <ul class="mt-4 space-y-4" role="list">
          <li class="flex items-start gap-3 text-sm text-[var(--sbg-text-muted)]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="mt-0.5 shrink-0 text-[var(--sbg-accent)]">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Universidad del Valle<br/>Cali, Colombia</span>
          </li>
          <li>
            <a
              href="mailto:aws.cloud.club@correounivalle.edu.co"
              class="inline-flex items-center gap-3 text-sm text-[var(--sbg-text-muted)] transition-colors duration-150 hover:text-white focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="shrink-0 text-[var(--sbg-accent)]">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              aws.cloud.club@correounivalle.edu.co
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Créditos de desarrollo -->
  <div class="border-t border-[var(--sbg-border)]">
    <div class="container-sbg py-6">
      <div class="flex flex-col items-center gap-3 text-center">
        <p class="text-xs font-semibold text-[var(--sbg-text-muted)]" style="font-family:'Space Mono',monospace;">
          Desarrollado por
        </p>
        <div class="flex flex-col items-center gap-3 sm:flex-row sm:gap-6">
          <div class="flex items-center gap-2">
            <span class="text-sm text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif; font-weight:600;">
              Pablo Nicolás Marín González
            </span>
            <a href="https://www.linkedin.com/in/pablo-nicolas-marin-gonzalez-33b8042a1/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Pablo Nicolás Marín González" class="flex h-6 w-6 items-center justify-center rounded-md text-[var(--sbg-text-subtle)] transition-colors hover:text-[var(--sbg-orange)] hover:bg-[var(--sbg-bg-elevated)] focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://github.com/Slylem0" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Pablo Nicolás Marín González" class="flex h-6 w-6 items-center justify-center rounded-md text-[var(--sbg-text-subtle)] transition-colors hover:text-[var(--sbg-orange)] hover:bg-[var(--sbg-bg-elevated)] focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
          </div>
          <span class="hidden sm:inline text-[var(--sbg-text-subtle)]">&</span>
          <div class="flex items-center gap-2">
            <span class="text-sm text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif; font-weight:600;">
              Gustavo Luna Sarmiento
            </span>
            <a href="https://www.linkedin.com/in/gustavo98luna/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Gustavo Luna Sarmiento" class="flex h-6 w-6 items-center justify-center rounded-md text-[var(--sbg-text-subtle)] transition-colors hover:text-[var(--sbg-orange)] hover:bg-[var(--sbg-bg-elevated)] focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://github.com/GustavoLS1" target="_blank" rel="noopener noreferrer" aria-label="GitHub de Gustavo Luna Sarmiento" class="flex h-6 w-6 items-center justify-center rounded-md text-[var(--sbg-text-subtle)] transition-colors hover:text-[var(--sbg-orange)] hover:bg-[var(--sbg-bg-elevated)] focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra inferior -->
  <div class="border-t border-[var(--sbg-border)]">
    <div class="container-sbg flex flex-col items-center justify-between gap-2 py-5 sm:flex-row">
      <p class="text-xs text-[var(--sbg-text-subtle)]">
        &copy; {currentYear} {SITE_CONFIG.name}. Todos los derechos reservados.
      </p>
      <p class="text-xs text-[var(--sbg-text-subtle)]">
        Parte del programa{' '}
        <a
          href="https://aws.amazon.com/developer/community/usergroups/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--sbg-text-muted)] underline underline-offset-4 transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded"
        >
          AWS User Groups
          <span class="sr-only">(abre en nueva pestaña)</span>
        </a>
      </p>
    </div>
  </div>

</footer>
