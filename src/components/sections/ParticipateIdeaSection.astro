---
/**
 * ParticipateIdeaSection — "¿Tienes alguna idea?"
 *
 * Bloque centrado que invita a compartir ideas para mejorar la comunidad.
 * El botón preselecciona el tipo IDEA en el formulario y hace scroll hacia él.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section
  aria-labelledby="participate-idea-heading"
  class:list={['relative py-16 lg:py-24 overflow-hidden', className]}
>
  <!-- Glows de fondo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(ellipse 70% 60% at 50% 50%,rgba(139,92,246,0.07) 0%,transparent 60%);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-8 right-[12%] h-2.5 w-2.5 rounded-full opacity-15"
    style="background: var(--sbg-accent); animation: float-circle 8s ease-in-out infinite 1s;"
  ></div>

  <div class="container-sbg relative z-10">
    <div
      data-animate
      class="idea-card relative mx-auto max-w-2xl rounded-3xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] p-10 text-center transition-all duration-500 hover:border-[var(--sbg-accent-border)] hover:shadow-2xl hover:shadow-[rgba(139,92,246,0.08)] sm:p-14"
    >
      <div class="relative z-10 mb-6 inline-flex items-center justify-center">
        <div
          class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--sbg-accent)] to-[var(--sbg-accent-hover)] shadow-xl shadow-[rgba(139,92,246,0.25)]"
        >
          <svg
            width="30"
            height="30"
            viewBox="0 0 24 24"
            fill="none"
            stroke="white"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18h6" />
            <path d="M10 22h4" />
            <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />
          </svg>
        </div>
      </div>

      <span class="code-label mb-3 inline-block"># participate.your_idea</span>
      <h2
        id="participate-idea-heading"
        class="text-[1.8rem] leading-[1.1] sm:text-[2.2rem]"
      >
        ¿Tienes alguna idea?
      </h2>
      <p
        class="mx-auto mt-4 max-w-lg text-base leading-[1.8] text-[var(--sbg-text-muted)]"
        style="font-family:'Nunito Sans',sans-serif;"
      >
        La comunidad también se construye con tus ideas. Si tienes una propuesta para
        un evento, una actividad, una alianza, un tema que te gustaría aprender o
        cualquier otra idea, queremos escucharte.
      </p>

      <div class="mt-8">
        <button
          type="button"
          id="share-idea-btn"
          data-proposal-type="IDEA"
          class="inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-xl bg-[var(--sbg-accent)] px-8 text-[0.9rem] font-bold text-white shadow-lg shadow-[rgba(139,92,246,0.3)] transition-all duration-200 hover:bg-[var(--sbg-accent-hover)] hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
          style="font-family:'Space Mono',monospace;"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
          Compartir mi idea
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('astro:page-load', function () {
    var btn = document.getElementById('share-idea-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      document.dispatchEvent(
        new CustomEvent('participate:select', { detail: { type: 'IDEA' } })
      );
    });
  });
</script>
