---
/**
 * AboutSocialSection — Sección de redes sociales prominente y visual.
 *
 * Tarjetas grandes con icono, nombre de plataforma y descripción corta.
 * Cada red tiene su color distintivo para identificación inmediata.
 * Responsive: 1 col mobile, 2 col tablet, 4 col desktop.
 */

import { ABOUT_SOCIAL_LINKS } from '@/lib/constants';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Platform-specific colors and descriptions
const platformMeta: Record<string, { color: string; bg: string; desc: string }> = {
  whatsapp: { color: '#25D366', bg: 'rgba(37,211,102,0.1)', desc: 'Únete al canal' },
  instagram: { color: '#E4405F', bg: 'rgba(228,64,95,0.1)', desc: 'Contenido y eventos' },
  youtube: { color: '#FF0000', bg: 'rgba(255,0,0,0.08)', desc: 'Workshops grabados' },
  email: { color: '#A78BFA', bg: 'rgba(139,92,246,0.1)', desc: 'Escríbenos' },
  linkedin: { color: '#0A66C2', bg: 'rgba(10,102,194,0.1)', desc: 'Networking' },
  github: { color: '#E5E7EB', bg: 'rgba(229,231,235,0.08)', desc: 'Proyectos open source' },
};
---

<section
  aria-labelledby="social-heading"
  class:list={['relative overflow-hidden py-20 sm:py-24', className]}
>
  <!-- Background -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.02]"
    style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:36px 36px;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-1/3 h-[40vh] w-[40vw] opacity-20"
    style="background:radial-gradient(ellipse at center,rgba(139,92,246,0.05) 0%,transparent 70%);"
  ></div>

  <div class="container-sbg">
    <!-- Header -->
    <div class="text-center mb-12" data-animate>
      <span class="code-label mb-3 inline-block"># síguenos</span>
      <h2
        id="social-heading"
        class="text-[2rem] leading-[1.1] sm:text-[2.6rem]"
      >
        Encuéntranos en <span class="text-[var(--sbg-accent-light)]">redes</span>
      </h2>
      <p class="mt-3 max-w-md mx-auto text-sm leading-relaxed text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
        Cada plataforma tiene un propósito. Síguenos donde más te convenga.
      </p>
    </div>

    <!-- Social grid -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 max-w-4xl mx-auto">
      {ABOUT_SOCIAL_LINKS.filter(link => link.href).map((link) => {
        const meta = platformMeta[link.key] || { color: '#A78BFA', bg: 'rgba(139,92,246,0.1)', desc: '' };
        return (
          <a
            href={link.href}
            aria-label={link.ariaLabel}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            data-animate
            class="social-card group relative flex flex-col items-center justify-center gap-3 rounded-2xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] p-7 min-h-[160px] transition-all duration-300 hover:-translate-y-1 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-2"
            style={`--card-color: ${meta.color}; --card-bg: ${meta.bg};`}
          >
            <!-- Hover glow -->
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style={`box-shadow: 0 0 40px ${meta.bg}, inset 0 0 30px ${meta.bg};`}
            ></div>

            <!-- Bottom accent line -->
            <div
              aria-hidden="true"
              class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 rounded-full transition-all duration-500 group-hover:w-2/3"
              style={`background: linear-gradient(90deg, transparent, ${meta.color}, transparent);`}
            ></div>

            <!-- Icon container -->
            <div
              class="relative z-10 flex h-14 w-14 items-center justify-center rounded-xl transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg"
              style={`background: ${meta.bg}; border: 1px solid ${meta.color}20;`}
            >
              <span class="[&>svg]:w-6 [&>svg]:h-6 transition-colors duration-300" style={`color: ${meta.color};`} set:html={link.icon} />
            </div>

            <!-- Platform name -->
            <span
              class="relative z-10 text-sm font-bold text-white"
              style="font-family:'Space Mono',monospace;"
            >
              {link.platform}
            </span>

            <!-- Description -->
            <span
              class="relative z-10 text-[11px] text-[var(--sbg-text-subtle)] text-center"
              style="font-family:'Nunito Sans',sans-serif;"
            >
              {meta.desc}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .social-card:hover {
    border-color: color-mix(in srgb, var(--card-color) 30%, transparent);
  }
</style>
