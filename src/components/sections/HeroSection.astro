---
/**
 * HeroSection — Sección Hero de la landing page.
 *
 * Layout:
 * - Mobile: columna única, texto arriba, ilustración abajo
 * - Desktop (≥ 1024px): dos columnas, texto izquierda, ilustración derecha
 *
 * Requisitos del spec satisfechos: 3.1, 3.2, 3.3, 3.4, 3.5
 *
 * Decisiones:
 * - La imagen hero es un SVG inline para evitar dependencias de archivos
 *   externos y garantizar LCP < 2.5s sin peticiones adicionales.
 * - Los botones son <a> semánticos (navegan), no <button> (acciones).
 * - fetchpriority="high" no aplica a SVG inline; el LCP lo consigue
 *   el hecho de que el SVG está en el HTML inicial (sin petición extra).
 * - Fondo con gradiente sutil del azul Univalle al blanco, Mobile First.
 */

interface Props {
  /** Clase CSS adicional para el elemento <section>. */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section
  aria-labelledby="hero-heading"
  class:list={[
    'relative overflow-hidden',
    'bg-gradient-to-br from-[var(--sbg-primary)] via-[var(--sbg-primary-light)] to-[#1a3a6e]',
    'py-16 sm:py-20 lg:py-28',
    className,
  ]}
>
  <!-- Patrón decorativo de fondo (puntos) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-10"
    style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 32px 32px;"
  >
  </div>

  <div class="container-sbg relative">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">

      <!-- ─── Columna de texto ─── -->
      <div class="text-center lg:text-left" data-animate>

        <!-- Badge "Bienvenido" -->
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--sbg-accent)]/40 bg-[var(--sbg-accent)]/10 px-4 py-1.5"
        >
          <span
            class="h-1.5 w-1.5 rounded-full bg-[var(--sbg-accent)]"
            aria-hidden="true"
          ></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--sbg-accent)]">
            AWS Student Builder Group
          </span>
        </div>

        <!-- Heading principal — único h1 de la página -->
        <h1
          id="hero-heading"
          class="font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl"
        >
          Construye el futuro
          <span class="block text-[var(--sbg-accent)]">en la nube</span>
        </h1>

        <!-- Subtítulo -->
        <p class="mt-6 text-base leading-relaxed text-white/80 sm:text-lg lg:max-w-xl">
          Somos la comunidad estudiantil AWS de la Universidad del Valle. Aprende
          tecnología cloud, certifícate con AWS y conecta con los mejores
          builders de Colombia.
        </p>

        <!-- CTAs -->
        <div
          class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start"
        >
          <!-- CTA primario: naranja AWS -->
          <a
            href="#cta"
            class:list={[
              'inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-xl sm:w-auto',
              'bg-[var(--sbg-accent)] px-7 py-3',
              'text-base font-semibold text-[var(--sbg-aws-dark)]',
              'transition-all duration-200 hover:bg-[var(--sbg-accent-hover)] hover:shadow-lg hover:shadow-[var(--sbg-accent)]/30',
              'focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2',
            ]}
          >
            <!-- Icono usuario -->
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            Únete al grupo
          </a>

          <!-- CTA secundario: borde blanco -->
          <a
            href="#eventos"
            class:list={[
              'inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-xl sm:w-auto',
              'border-2 border-white/40 px-7 py-3',
              'text-base font-semibold text-white',
              'transition-all duration-200 hover:border-white hover:bg-white/10',
              'focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2',
            ]}
          >
            <!-- Icono calendario -->
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            Ver próximos eventos
          </a>
        </div>

        <!-- Indicadores de confianza -->
        <div
          class="mt-10 flex flex-wrap items-center justify-center gap-6 lg:justify-start"
          aria-label="Datos del grupo"
        >
          {
            [
              { value: '700+', label: 'Miembros' },
              { value: '15+', label: 'Eventos' },
              { value: '2', label: 'Proyectos cloud' },
            ].map(({ value, label }) => (
              <div class="flex flex-col items-center lg:items-start">
                <span class="font-display text-2xl font-extrabold text-[var(--sbg-accent)]">
                  {value}
                </span>
                <span class="text-xs text-white/60">{label}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ─── Columna de ilustración ─── -->
      <div class="flex justify-center lg:justify-end" data-animate aria-hidden="true">
        <!--
          Ilustración SVG inline del Hero.
          Sin petición de red → LCP inmediato.
          aria-hidden porque es decorativa; el texto comunica el contenido.
        -->
        <svg
          viewBox="0 0 480 400"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="w-full max-w-sm lg:max-w-md xl:max-w-lg"
          role="img"
          aria-label="Ilustración de estudiantes construyendo en la nube AWS"
        >
          <!-- Nube central AWS -->
          <ellipse cx="240" cy="160" rx="120" ry="70" fill="#FF9900" fill-opacity="0.15"/>
          <path
            d="M160 160 Q160 100 200 100 Q210 70 240 70 Q270 70 280 100 Q320 100 320 140 Q340 140 340 160 Q340 180 320 180 H160 Q140 180 140 160 Q140 140 160 140 Z"
            fill="#FF9900"
            fill-opacity="0.25"
            stroke="#FF9900"
            stroke-width="2"
          />

          <!-- Servicios AWS flotando alrededor de la nube -->
          <!-- S3 -->
          <rect x="120" y="100" width="44" height="44" rx="10" fill="#1a3a6e" stroke="#FF9900" stroke-width="1.5"/>
          <text x="142" y="120" text-anchor="middle" font-size="9" font-family="monospace" fill="#FF9900" font-weight="bold">S3</text>
          <text x="142" y="132" text-anchor="middle" font-size="7" font-family="sans-serif" fill="white" fill-opacity="0.7">Storage</text>

          <!-- Lambda -->
          <rect x="316" y="100" width="44" height="44" rx="10" fill="#1a3a6e" stroke="#FF9900" stroke-width="1.5"/>
          <text x="338" y="120" text-anchor="middle" font-size="9" font-family="monospace" fill="#FF9900" font-weight="bold">λ</text>
          <text x="338" y="132" text-anchor="middle" font-size="7" font-family="sans-serif" fill="white" fill-opacity="0.7">Lambda</text>

          <!-- EC2 -->
          <rect x="196" y="200" width="44" height="44" rx="10" fill="#1a3a6e" stroke="#FF9900" stroke-width="1.5"/>
          <text x="218" y="220" text-anchor="middle" font-size="9" font-family="monospace" fill="#FF9900" font-weight="bold">EC2</text>
          <text x="218" y="232" text-anchor="middle" font-size="7" font-family="sans-serif" fill="white" fill-opacity="0.7">Compute</text>

          <!-- RDS -->
          <rect x="240" y="200" width="44" height="44" rx="10" fill="#1a3a6e" stroke="#FF9900" stroke-width="1.5"/>
          <text x="262" y="220" text-anchor="middle" font-size="9" font-family="monospace" fill="#FF9900" font-weight="bold">RDS</text>
          <text x="262" y="232" text-anchor="middle" font-size="7" font-family="sans-serif" fill="white" fill-opacity="0.7">Database</text>

          <!-- Líneas conectoras (cloud → services) -->
          <line x1="160" y1="144" x2="142" y2="144" stroke="#FF9900" stroke-width="1" stroke-dasharray="4 3" opacity="0.5"/>
          <line x1="320" y1="144" x2="338" y2="144" stroke="#FF9900" stroke-width="1" stroke-dasharray="4 3" opacity="0.5"/>
          <line x1="218" y1="180" x2="218" y2="200" stroke="#FF9900" stroke-width="1" stroke-dasharray="4 3" opacity="0.5"/>
          <line x1="262" y1="180" x2="262" y2="200" stroke="#FF9900" stroke-width="1" stroke-dasharray="4 3" opacity="0.5"/>

          <!-- Figura estudiante 1 (izquierda) -->
          <circle cx="170" cy="290" r="18" fill="#1a3a6e" stroke="#FF9900" stroke-width="1.5"/>
          <rect x="155" y="310" width="30" height="50" rx="8" fill="#1a3a6e" stroke="#FF9900" stroke-width="1.5"/>
          <!-- Laptop -->
          <rect x="180" y="320" width="50" height="32" rx="4" fill="#FF9900" fill-opacity="0.2" stroke="#FF9900" stroke-width="1.5"/>
          <rect x="178" y="352" width="54" height="4" rx="2" fill="#FF9900" fill-opacity="0.4"/>

          <!-- Figura estudiante 2 (derecha) -->
          <circle cx="310" cy="290" r="18" fill="#003087" stroke="#FF9900" stroke-width="1.5"/>
          <rect x="295" y="310" width="30" height="50" rx="8" fill="#003087" stroke="#FF9900" stroke-width="1.5"/>
          <!-- Laptop -->
          <rect x="250" y="320" width="50" height="32" rx="4" fill="#FF9900" fill-opacity="0.2" stroke="#FF9900" stroke-width="1.5"/>
          <rect x="248" y="352" width="54" height="4" rx="2" fill="#FF9900" fill-opacity="0.4"/>

          <!-- Badge certificación (flotando) -->
          <circle cx="390" cy="250" r="28" fill="#FF9900" fill-opacity="0.15" stroke="#FF9900" stroke-width="1.5"/>
          <text x="390" y="245" text-anchor="middle" font-size="18" fill="#FF9900">★</text>
          <text x="390" y="262" text-anchor="middle" font-size="8" font-family="sans-serif" fill="white" fill-opacity="0.8">AWS</text>

          <!-- Badge "Builder" (flotando) -->
          <rect x="60" y="240" width="60" height="28" rx="14" fill="#FF9900" fill-opacity="0.2" stroke="#FF9900" stroke-width="1.5"/>
          <text x="90" y="258" text-anchor="middle" font-size="9" font-family="sans-serif" fill="#FF9900" font-weight="bold">BUILDER</text>

          <!-- Partículas decorativas -->
          <circle cx="100" cy="60" r="3" fill="#FF9900" opacity="0.6"/>
          <circle cx="380" cy="80" r="2" fill="#FF9900" opacity="0.4"/>
          <circle cx="420" cy="200" r="4" fill="#FF9900" opacity="0.3"/>
          <circle cx="60" cy="320" r="3" fill="#FF9900" opacity="0.5"/>
          <circle cx="440" cy="340" r="2" fill="#FF9900" opacity="0.4"/>
        </svg>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div
      class="mt-12 flex justify-center lg:mt-16"
      aria-hidden="true"
    >
      <a
        href="#quienes-somos"
        class="flex flex-col items-center gap-1 text-white/40 transition-colors hover:text-white/70 focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-4 focus-visible:rounded"
        aria-label="Ir a la sección Quiénes somos"
      >
        <span class="text-xs">Conoce más</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
          class="animate-bounce"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </a>
    </div>
  </div>
</section>
