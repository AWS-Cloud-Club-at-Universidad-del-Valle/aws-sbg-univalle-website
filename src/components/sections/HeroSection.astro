---
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---

<section
  aria-labelledby="hero-heading"
  id="hero-section"
  class:list={['relative overflow-hidden bg-[var(--sbg-bg)]', className]}
  style="min-height: 100svh; display: flex; align-items: center;"
>
  <div id="cursor-spotlight" aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-0 opacity-0 transition-opacity duration-300"
    style="background: radial-gradient(600px circle at 50% 50%, rgba(255,153,0,0.06) 0%, transparent 70%);">
  </div>

  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[60vh]"
    style="background:radial-gradient(ellipse 55% 45% at 30% 0%,rgba(255,153,0,0.08) 0%,transparent 65%);"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-0 right-0 h-[50vh] w-[50vw]"
    style="background:radial-gradient(ellipse at 80% 100%,rgba(35,47,62,0.35) 0%,transparent 60%);"></div>

  <canvas id="hero-canvas" aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full opacity-75"></canvas>

  <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.025]"
    style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:36px 36px;"></div>

  <!-- Logo AWS — visible solo en mobile/tablet (la columna derecha está oculta) -->
  <div class="hero-animate hero-animate-delay-1 aws-logo-wrapper aws-logo-mobile">
    <img
      src="https://d23d5d88jw9p2.cloudfront.net/dev-assets/dev-logos/logo_oficial_aws.png"
      alt="AWS"
      class="aws-logo"
      loading="eager"
      width="120"
      height="72"
    />
  </div>

  <div class="container-sbg relative z-10 py-24 lg:py-32">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2 lg:gap-24">

      <!-- Columna texto -->
      <div class="text-center lg:text-left">

        <div class="hero-animate hero-animate-delay-1 mb-5">
          <span class="code-label"># aws.student_builder_group</span>
        </div>

        <h1 id="hero-heading"
          class="hero-animate hero-animate-delay-2 text-[2.6rem] leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[3.4rem] xl:text-[3.8rem]">
          Construye el<br/>
          <span class="text-[var(--sbg-accent-light)]">futuro en la nube</span>
        </h1>

        <p class="hero-animate hero-animate-delay-3 mt-6 max-w-md text-base leading-[1.8] text-[var(--sbg-text-muted)] sm:text-lg lg:mx-0 mx-auto"
          style="font-family:'Nunito Sans',sans-serif;">
          Comunidad estudiantil AWS en la Universidad del Valle.
          Aprende, certifícate y construye con los mejores builders de Colombia.
        </p>

        <div class="hero-animate hero-animate-delay-4 mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a href="https://www.meetup.com/aws-sbg-at-university-of-the-valley-cali/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[48px] w-full items-center justify-center gap-2.5 rounded-xl bg-[var(--sbg-accent)] px-8 text-[0.9rem] font-bold text-white shadow-lg shadow-[rgba(139,92,246,0.3)] transition-all duration-200 hover:bg-[var(--sbg-accent-hover)] hover:-translate-y-px sm:w-auto focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
            style="font-family:'Space Mono',monospace;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/>
              <line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
            Únete al grupo
          </a>
          <a href="#eventos"
            class="inline-flex min-h-[48px] w-full items-center justify-center gap-2.5 rounded-xl border border-[var(--sbg-border)] bg-white/[0.03] px-8 text-[0.9rem] font-semibold text-[var(--sbg-text-muted)] transition-all duration-200 hover:border-white/20 hover:bg-white/[0.07] hover:text-white sm:w-auto focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:outline-offset-2"
            style="font-family:'Space Mono',monospace;">
            Ver eventos
          </a>
        </div>

        <div class="hero-animate hero-animate-delay-5 mt-12 flex flex-wrap justify-center gap-8 lg:justify-start">
          {[
            { value: '700+', label: 'miembros',  code: '# members'   },
            { value: '15+',  label: 'eventos',   code: '# events'    },
            { value: '1er',  label: 'capítulo en Univalle', code: '# chapter' },
          ].map(({ value, label, code }) => (
            <div class="flex flex-col items-center lg:items-start gap-0.5">
              <span class="code-label text-[10px]">{code}</span>
              <span class="text-2xl font-bold text-white leading-none" style="font-family:'Space Mono',monospace;">{value}</span>
              <span class="text-[11px] text-[var(--sbg-text-muted)] uppercase tracking-widest" style="font-family:'Nunito Sans',sans-serif;">{label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna derecha: panel de servicio activo -->
      <div class="hero-animate hero-animate-delay-3 hidden lg:flex flex-col items-center justify-center gap-4 select-none pointer-events-none relative">
        <!-- Logo AWS — encima de la tarjeta interactiva, solo visible en desktop -->
        <div class="aws-logo-wrapper aws-logo-desktop">
          <img
            src="https://d23d5d88jw9p2.cloudfront.net/dev-assets/dev-logos/logo_oficial_aws.png"
            alt=""
            class="aws-logo pointer-events-auto"
            loading="eager"
            width="120"
            height="72"
          />
        </div>
        <span class="code-label"># mueve el cursor para interactuar</span>
        <div id="active-service-label"
          class="rounded-xl border border-[var(--sbg-border-accent)] bg-[var(--sbg-bg-surface)] px-6 py-4 text-center transition-all duration-300"
          style="min-width:230px;min-height:68px;backdrop-filter:blur(8px);">
          <p id="svc-name" class="text-base font-bold text-[var(--sbg-text)]" style="font-family:'Space Mono',monospace;"></p>
          <p id="svc-desc" class="mt-1.5 text-[11px] text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;line-height:1.5;"></p>
        </div>
      </div>

      <!-- Panel de servicio activo (mobile) -->
      <div class="hero-animate hero-animate-delay-4 flex lg:hidden flex-col items-center mt-8 select-none pointer-events-none">
        <span class="code-label text-[10px] mb-2"># toca las bolitas para explorar</span>
        <div id="active-service-label-mobile"
          class="rounded-xl border border-[var(--sbg-border-accent)] bg-[var(--sbg-bg-surface)] px-5 py-3 text-center transition-all duration-300 min-h-[56px] min-w-[200px]"
          style="backdrop-filter:blur(8px);">
          <p id="svc-name-mobile" class="text-sm font-bold text-[var(--sbg-text)]" style="font-family:'Space Mono',monospace;"></p>
          <p id="svc-desc-mobile" class="mt-1 text-[10px] text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;line-height:1.4;"></p>
        </div>
      </div>

    </div>

    <!-- Scroll indicator -->
    <div class="mt-16 flex justify-center">
      <a href="#quienes-somos" aria-label="Ir a Quiénes somos"
        class="flex flex-col items-center gap-2 text-[var(--sbg-text-muted)] transition-colors duration-200 hover:text-[var(--sbg-text)] focus-visible:outline-2 focus-visible:outline-[var(--sbg-accent)] focus-visible:rounded">
        <span class="code-label text-[10px]">scroll</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="animate-bounce">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* AWS Logo — posicionado encima de la tarjeta interactiva en desktop,
     y en la esquina superior derecha del Hero en mobile/tablet. */

  /* Versión mobile/tablet: posicionada respecto al <section#hero-section> */
  .aws-logo-mobile {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Ocultar en desktop (donde se muestra la versión dentro de la columna derecha) */
  @media (min-width: 1024px) {
    .aws-logo-mobile {
      display: none;
    }
  }

  /* Versión desktop: se muestra como parte del flujo de la columna derecha,
     centrada horizontalmente encima de la tarjeta interactiva. */
  .aws-logo-desktop {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }

  .aws-logo {
    width: 64px;
    height: auto;
    filter: drop-shadow(0 0 0px transparent);
    transition: filter 300ms ease-out, transform 300ms ease-out;
  }

  .aws-logo:hover {
    filter: brightness(1.1) drop-shadow(0 0 12px rgba(255, 153, 0, 0.5)) drop-shadow(0 0 24px rgba(255, 153, 0, 0.25));
    transform: scale(1.06);
  }

  @media (min-width: 640px) {
    .aws-logo-mobile {
      top: 1.5rem;
      right: 1.5rem;
    }
    .aws-logo {
      width: 80px;
    }
  }

  @media (min-width: 1024px) {
    .aws-logo {
      width: 100px;
    }
  }

  @media (min-width: 1280px) {
    .aws-logo {
      width: 120px;
    }
  }

  /* prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .aws-logo {
      transition: none;
    }
    .aws-logo:hover {
      transform: none;
      filter: brightness(1.1) drop-shadow(0 0 12px rgba(255, 153, 0, 0.5));
    }
  }
</style>

<script is:inline>
document.addEventListener('astro:page-load', function initHeroCanvas() {
  var canvas    = document.getElementById('hero-canvas');
  var spotlight = document.getElementById('cursor-spotlight');
  var svcName   = document.getElementById('svc-name');
  var svcDesc   = document.getElementById('svc-desc');
  var svcNameMob = document.getElementById('svc-name-mobile');
  var svcDescMob = document.getElementById('svc-desc-mobile');
  var section   = document.getElementById('hero-section');
  if (!canvas || !section) return;

  var ctx = canvas.getContext('2d');
  var W, H, raf;
  var mouse = { x: -9999, y: -9999, active: false };
  var hoveredNode = null;

  var COLORS = {
    compute:  '#FF9900',
    storage:  '#3F8624',
    database: '#2E73B8',
    network:  '#8C4FFF',
    ml:       '#01A88D',
  };

  var AWS_NODES = [
    { label: 'EC2',         desc: 'Servidores virtuales escalables en la nube',        cat: 'compute'  },
    { label: 'Lambda',      desc: 'Funciones serverless sin infraestructura propia',   cat: 'compute'  },
    { label: 'S3',          desc: 'Almacenamiento de objetos ilimitado y duradero',    cat: 'storage'  },
    { label: 'RDS',         desc: 'Bases de datos relacionales administradas por AWS', cat: 'database' },
    { label: 'DynamoDB',    desc: 'NoSQL con latencia de un solo dígito en ms',        cat: 'database' },
    { label: 'CloudFront',  desc: 'CDN global con más de 400 puntos de presencia',     cat: 'network'  },
    { label: 'VPC',         desc: 'Red virtual privada completamente aislada',         cat: 'network'  },
    { label: 'IAM',         desc: 'Control de identidades y permisos en AWS',          cat: 'network'  },
    { label: 'ECS',         desc: 'Orquestación de contenedores Docker en AWS',        cat: 'compute'  },
    { label: 'Route 53',    desc: 'Servicio DNS escalable y de alta disponibilidad',   cat: 'network'  },
    { label: 'CloudWatch',  desc: 'Monitoreo y observabilidad en tiempo real',         cat: 'storage'  },
    { label: 'API Gateway', desc: 'Creación y gestión de APIs REST y WebSocket',       cat: 'network'  },
    { label: 'Cognito',     desc: 'Autenticación y gestión de usuarios',               cat: 'network'  },
    { label: 'SQS',         desc: 'Cola de mensajes totalmente administrada',          cat: 'storage'  },
    { label: 'Bedrock',     desc: 'IA generativa con modelos fundacionales de AWS',    cat: 'ml'       },
    { label: 'SageMaker',   desc: 'Machine Learning end-to-end en la nube',            cat: 'ml'       },
    { label: 'Aurora',      desc: 'Base de datos relacional 5x más rápida que MySQL',  cat: 'database' },
    { label: 'EKS',         desc: 'Kubernetes totalmente administrado por AWS',        cat: 'compute'  },
  ];

  var nodes = [];

  function resize() {
    W = canvas.width  = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
    placeNodes();
  }

  function placeNodes() {
    nodes = AWS_NODES.map(function(svc, i) {
      var cols = 5;
      var col  = i % cols;
      var row  = Math.floor(i / cols);
      var totalRows = Math.ceil(AWS_NODES.length / cols);
      var baseX = (col + 0.5) / cols * W;
      var baseY = (row + 0.5) / totalRows * H;
      var seed  = (i * 2654435761) >>> 0;
      var jx = ((seed & 0xFF) / 255 - 0.5) * (W / cols) * 0.5;
      var jy = (((seed >> 8) & 0xFF) / 255 - 0.5) * (H / totalRows) * 0.5;
      return {
        label: svc.label,
        desc:  svc.desc,
        color: COLORS[svc.cat] || '#FF9900',
        x: baseX + jx, y: baseY + jy,
        vx: (Math.random() - 0.5) * 0.15,
        vy: (Math.random() - 0.5) * 0.15,
        r: 0, targetR: 22, alpha: 0, targetAlpha: 0.85,
      };
    });
  }

  var EDGES = [
    [0,1],[0,2],[1,3],[1,4],[2,11],[3,4],[4,7],
    [5,6],[5,9],[6,7],[7,12],[8,0],[9,5],[10,0],
    [10,3],[11,0],[12,7],[13,10],[14,15],[3,16],[0,17],
  ];

  function draw() {
    ctx.clearRect(0, 0, W, H);
    var now = performance.now();

    nodes.forEach(function(n) {
      n.x += n.vx; n.y += n.vy;
      var pad = 50;
      if (n.x < pad || n.x > W - pad) n.vx *= -1;
      if (n.y < pad || n.y > H - pad) n.vy *= -1;
      var dx = mouse.x - n.x, dy = mouse.y - n.y;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist < 200 && mouse.active) {
        n.x += dx * 0.014; n.y += dy * 0.014;
        n.targetR = 35; n.targetAlpha = 1;
      } else {
        n.targetR = 22; n.targetAlpha = 0.85;
      }
      n.r     += (n.targetR     - n.r)     * 0.08;
      n.alpha += (n.targetAlpha - n.alpha) * 0.06;
    });

    EDGES.forEach(function(e) {
      var na = nodes[e[0]], nb = nodes[e[1]];
      if (!na || !nb) return;
      var d = Math.hypot(nb.x - na.x, nb.y - na.y);
      if (d > 320) return;
      ctx.beginPath();
      ctx.moveTo(na.x, na.y);
      ctx.lineTo(nb.x, nb.y);
      ctx.strokeStyle = 'rgba(74,144,217,' + (1 - d/320) * 0.08 + ')';
      ctx.lineWidth = 0.6;
      ctx.stroke();
    });

    var closestDist = Infinity, closestNode = null;
    nodes.forEach(function(n) {
      var dx = mouse.x - n.x, dy = mouse.y - n.y;
      var dist = Math.hypot(dx, dy);
      var MAX = 240;
      if (dist < MAX && mouse.active) {
        var t = 1 - dist / MAX;
        var grad = ctx.createLinearGradient(mouse.x, mouse.y, n.x, n.y);
        grad.addColorStop(0, 'rgba(255,153,0,' + (t * 0.6) + ')');
        grad.addColorStop(1, n.color + Math.round(t * 0.5 * 255).toString(16).padStart(2,'0'));
        ctx.beginPath();
        ctx.moveTo(mouse.x, mouse.y);
        ctx.lineTo(n.x, n.y);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 0.6 + t * 1.2;
        ctx.stroke();
      }
      if (dist < closestDist) { closestDist = dist; closestNode = n; }
    });

    if (closestDist < 200 && mouse.active && closestNode !== hoveredNode) {
      hoveredNode = closestNode;
      if (svcName) svcName.textContent = closestNode.label;
      if (svcDesc) svcDesc.textContent = closestNode.desc;
      if (svcNameMob) svcNameMob.textContent = closestNode.label;
      if (svcDescMob) svcDescMob.textContent = closestNode.desc;
    } else if ((closestDist >= 200 || !mouse.active) && hoveredNode) {
      hoveredNode = null;
      if (svcName) svcName.textContent = '';
      if (svcDesc) svcDesc.textContent = '';
      if (svcNameMob) svcNameMob.textContent = '';
      if (svcDescMob) svcDescMob.textContent = '';
    }

    if (mouse.active) {
      var pulse = (Math.sin(now * 0.003) + 1) * 0.5;
      ctx.beginPath();
      ctx.arc(mouse.x, mouse.y, 22 + pulse * 8, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(255,153,0,' + (0.08 + pulse * 0.1) + ')';
      ctx.lineWidth = 1; ctx.stroke();
      ctx.beginPath();
      ctx.arc(mouse.x, mouse.y, 12 + pulse * 4, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(46,115,184,' + (0.12 + pulse * 0.1) + ')';
      ctx.lineWidth = 1; ctx.stroke();
      ctx.beginPath();
      ctx.arc(mouse.x, mouse.y, 3.5, 0, Math.PI * 2);
      ctx.fillStyle = '#FF9900';
      ctx.shadowColor = '#FF9900';
      ctx.shadowBlur = 10;
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    nodes.forEach(function(n) {
      ctx.shadowColor = n.color;
      ctx.shadowBlur  = n.r > 28 ? 20 : 8;
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r * 0.4, 0, Math.PI * 2);
      ctx.fillStyle = n.color + Math.round(n.alpha * 0.25 * 255).toString(16).padStart(2,'0');
      ctx.fill();

      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r * 0.2, 0, Math.PI * 2);
      ctx.fillStyle = n.color + Math.round(n.alpha * 0.8 * 255).toString(16).padStart(2,'0');
      ctx.fill();

      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r * 0.4, 0, Math.PI * 2);
      ctx.strokeStyle = n.color + Math.round(n.alpha * 255).toString(16).padStart(2,'0');
      ctx.lineWidth = 2; ctx.stroke();
      ctx.shadowBlur = 0;

      ctx.font = (n.r > 28 ? '700 12px' : '700 10px') + " 'Space Mono',monospace";
      ctx.textAlign = 'center';
      ctx.fillStyle = 'rgba(229,231,235,' + (n.alpha * 0.95) + ')';
      ctx.fillText(n.label, n.x, n.y + n.r * 0.4 + 15);
    });

    raf = requestAnimationFrame(draw);
  }

  function updateSpotlight(x, y) {
    if (!spotlight) return;
    spotlight.style.background = 'radial-gradient(500px circle at ' + x + 'px ' + y + 'px, rgba(255,153,0,0.06) 0%, transparent 70%)';
    spotlight.style.opacity = '1';
  }

  section.addEventListener('mousemove', function(e) {
    var rect = canvas.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
    mouse.active = true;
    updateSpotlight(e.clientX, e.clientY);
  });
  section.addEventListener('mouseleave', function() {
    mouse.active = false;
    if (spotlight) spotlight.style.opacity = '0';
  });
  section.addEventListener('touchmove', function(e) {
    var rect = canvas.getBoundingClientRect();
    var touch = e.touches[0];
    mouse.x = touch.clientX - rect.left;
    mouse.y = touch.clientY - rect.top;
    mouse.active = true;
  }, { passive: true });
  section.addEventListener('touchstart', function(e) {
    var rect = canvas.getBoundingClientRect();
    var touch = e.touches[0];
    mouse.x = touch.clientX - rect.left;
    mouse.y = touch.clientY - rect.top;
    mouse.active = true;
  }, { passive: true });
  section.addEventListener('touchend', function() {
    mouse.active = false;
  });

  var ro = new ResizeObserver(resize);
  ro.observe(canvas);
  resize();
  draw();

  document.addEventListener('astro:before-swap', function cleanup() {
    cancelAnimationFrame(raf);
    ro.disconnect();
    document.removeEventListener('astro:before-swap', cleanup);
  });
});
</script>
