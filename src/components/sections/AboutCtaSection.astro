---
/**
 * AboutCtaSection — Sección CTA final de la página About.
 *
 * Invita al usuario a unirse a la comunidad vía LinkedIn.
 * Usa el patrón de botón accent con gradiente y animación hover.
 */

import { SITE_CONFIG } from '@/lib/constants';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  aria-labelledby="cta-heading"
  class:list={['relative overflow-hidden py-24 sm:py-32', className]}
  data-animate
>
  <!-- Borde superior decorativo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 inset-x-0 h-px"
    style="background: linear-gradient(90deg, transparent, var(--sbg-accent-border), transparent);"
  ></div>
  <!-- Radial gradient prominente -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse at 50% 30%, rgba(139,92,246,0.08) 0%, transparent 60%);"
  ></div>
  <!-- Dot grid pattern -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.025]"
    style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:36px 36px;"
  ></div>
  <!-- Floating shapes -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-12 left-8 h-0 w-0 opacity-15"
    style="border-left: 8px solid transparent; border-right: 8px solid transparent; border-bottom: 14px solid var(--sbg-accent-light); animation: float-triangle 7s ease-in-out infinite;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-16 right-12 h-3 w-3 rounded-full opacity-10"
    style="background: var(--sbg-orange); animation: float-circle 8s ease-in-out infinite 1s;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute hidden sm:block top-1/3 right-[10%] h-2.5 w-2.5 opacity-10"
    style="background: var(--sbg-accent); animation: float-rhombus 9s ease-in-out infinite 2s;"
  ></div>

  <div class="container-sbg text-center">
    <h2
      id="cta-heading"
      class="text-3xl font-bold sm:text-4xl"
      data-animate
    >
      ¡Únete a la comunidad!
    </h2>

    <p
      class="mx-auto mt-4 max-w-lg text-base leading-relaxed text-[var(--sbg-text-muted)] sm:text-lg"
      style="font-family:'Nunito Sans',sans-serif;"
      data-animate
    >
      Forma parte de la comunidad AWS más activa de la Universidad del Valle y lleva tus habilidades cloud al siguiente nivel.
    </p>

    <div class="mt-8" data-animate>
      <a
        href={SITE_CONFIG.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[48px] items-center justify-center gap-2.5 rounded-xl bg-[var(--sbg-accent)] px-8 text-[0.9rem] font-bold text-white shadow-lg shadow-[rgba(139,92,246,0.3)] transition-all duration-200 hover:bg-[var(--sbg-accent-hover)] hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
        style="font-family:'Space Mono',monospace;"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        Únete en LinkedIn
      </a>
    </div>
  </div>
</section>
