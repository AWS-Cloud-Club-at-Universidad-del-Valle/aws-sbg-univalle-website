---
/**
 * ContactSection — Meetup-focused CTA for the homepage.
 * Prominently features the Meetup page as the official way to join the community.
 * Uses the site palette (orange + purple) for cohesion.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const meetupUrl = 'https://www.meetup.com/aws-sbg-at-university-of-the-valley-cali/';
---

<section
  id="contacto"
  aria-labelledby="contact-heading"
  class:list={['relative py-24 lg:py-32 overflow-hidden', className]}
>
  <!-- Animated background glows -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(ellipse 70% 60% at 50% 70%,rgba(139,92,246,0.06) 0%,transparent 60%);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-1/4 h-[50vh] w-[50vw] opacity-40"
    style="background:radial-gradient(ellipse at 30% 20%,rgba(255,153,0,0.05) 0%,transparent 60%);"
  ></div>

  <!-- Floating particles -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-12 right-[15%] h-3 w-3 rounded-full opacity-20"
    style="background: var(--sbg-orange); animation: float-circle 6s ease-in-out infinite;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-16 left-[10%] h-2 w-2 rounded-full opacity-15"
    style="background: var(--sbg-accent); animation: float-circle 8s ease-in-out infinite 2s;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/3 right-[8%] h-2.5 w-2.5 opacity-15"
    style="background: var(--sbg-orange); animation: float-rhombus 7s ease-in-out infinite 1s;"
  ></div>

  <div class="container-sbg relative z-10">
    <div
      data-animate
      class="meetup-cta-container relative mx-auto max-w-2xl rounded-3xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] p-10 text-center transition-all duration-500 hover:border-[var(--sbg-accent-border)] hover:shadow-2xl hover:shadow-[rgba(139,92,246,0.08)] sm:p-14"
    >
      <!-- Cursor glow overlay -->
      <div
        aria-hidden="true"
        class="meetup-glow pointer-events-none absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-500"
      ></div>

      <!-- Icon area -->
      <div class="relative z-10 mb-6 inline-flex items-center justify-center">
        <div class="flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--sbg-orange)] to-[var(--sbg-accent)] shadow-2xl shadow-[rgba(255,153,0,0.25)] transition-transform duration-300 hover:scale-110">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
      </div>

      <!-- Header -->
      <div class="relative z-10">
        <span class="code-label mb-3 inline-block"># nuestra_comunidad</span>
        <h2
          id="contact-heading"
          class="text-[1.8rem] leading-[1.1] sm:text-[2.4rem] lg:text-[2.8rem]"
        >
          Síguenos en <span class="text-[var(--sbg-orange)]">Meetup</span>
        </h2>
        <p
          class="mt-4 text-base leading-[1.8] text-[var(--sbg-text-muted)] max-w-lg mx-auto"
          style="font-family:'Nunito Sans',sans-serif;"
        >
          Nuestra página oficial es Meetup. Ahí publicamos todos los eventos, workshops y actividades. Seguirnos es lo único que necesitas para ser parte.
        </p>
      </div>

      <!-- CTA Button -->
      <div class="relative z-10 mt-9">
        <a
          href={meetupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="meetup-btn group relative inline-flex min-h-[56px] items-center gap-3 rounded-2xl bg-gradient-to-r from-[var(--sbg-orange)] to-[var(--sbg-accent)] px-10 py-4 text-[1rem] font-bold text-white shadow-xl shadow-[rgba(255,153,0,0.25)] transition-all duration-300 hover:shadow-2xl hover:shadow-[rgba(255,153,0,0.4)] hover:-translate-y-1 hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4"
          style="font-family:'Space Mono',monospace;"
        >
          <!-- Shimmer effect -->
          <span
            aria-hidden="true"
            class="absolute inset-0 rounded-2xl bg-gradient-to-r from-transparent via-white/15 to-transparent -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-1000"
          ></span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="relative z-10">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span class="relative z-10">Ir al Meetup</span>
        </a>
      </div>

      <!-- Subtitle -->
      <p
        class="relative z-10 mt-6 text-xs text-[var(--sbg-text-muted)]"
        style="font-family:'Nunito Sans',sans-serif;"
      >
        Sin proceso de admisión. Solo haz clic, síguenos y ya eres parte.
      </p>

      <!-- Stats row -->
      <div class="relative z-10 mt-8 flex flex-wrap items-center justify-center gap-8 border-t border-[var(--sbg-border)] pt-8">
        <div class="flex flex-col items-center gap-0.5">
          <span class="code-label text-[10px]"># events</span>
          <span class="text-xl font-bold text-white" style="font-family:'Space Mono',monospace;">27</span>
          <span class="text-[10px] text-[var(--sbg-text-muted)] uppercase tracking-widest">eventos</span>
        </div>
        <div class="flex flex-col items-center gap-0.5">
          <span class="code-label text-[10px]"># members</span>
          <span class="text-xl font-bold text-white" style="font-family:'Space Mono',monospace;">922</span>
          <span class="text-[10px] text-[var(--sbg-text-muted)] uppercase tracking-widest">miembros</span>
        </div>
        <div class="flex flex-col items-center gap-0.5">
          <span class="code-label text-[10px]"># cost</span>
          <span class="text-xl font-bold text-[var(--sbg-orange)]" style="font-family:'Space Mono',monospace;">$0</span>
          <span class="text-[10px] text-[var(--sbg-text-muted)] uppercase tracking-widest">gratis</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener('astro:page-load', function() {
  var container = document.querySelector('.meetup-cta-container');
  if (!container) return;
  var glow = container.querySelector('.meetup-glow');
  if (!glow) return;

  container.addEventListener('mousemove', function(e) {
    var rect = container.getBoundingClientRect();
    var x = e.clientX - rect.left;
    var y = e.clientY - rect.top;
    glow.style.background = 'radial-gradient(400px circle at ' + x + 'px ' + y + 'px, rgba(255,153,0,0.1) 0%, rgba(139,92,246,0.05) 40%, transparent 70%)';
    glow.style.opacity = '1';
  });

  container.addEventListener('mouseleave', function() {
    glow.style.opacity = '0';
  });
});
</script>
