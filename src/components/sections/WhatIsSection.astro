---
/**
 * WhatIsSection — Explains what an AWS Student Builder Group is.
 * Features a cursor-tracking glow effect and scroll-reveal animations.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const pillars = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    title: 'Aprendizaje práctico',
    description: 'Workshops, labs y proyectos reales usando servicios AWS. No solo teoría, sino hands-on desde el primer día.',
    glowColor: 'rgba(255,153,0,0.4)',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Comunidad estudiantil',
    description: 'Un espacio para conectar con otros estudiantes apasionados por la tecnología cloud y la innovación.',
    glowColor: 'rgba(139,92,246,0.4)',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>`,
    title: 'Respaldo de AWS',
    description: 'Programa oficial de Amazon Web Services con acceso a recursos, créditos y mentores de la industria.',
    glowColor: 'rgba(1,168,141,0.4)',
  },
];
---

<section
  id="quienes-somos"
  aria-labelledby="what-is-heading"
  class:list={['relative py-20 lg:py-28 overflow-hidden', className]}
>
  <!-- Decorative background elements -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-1/4 h-[40vh] w-[40vw] opacity-30"
    style="background:radial-gradient(ellipse at center,rgba(139,92,246,0.06) 0%,transparent 70%);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 right-0 h-[30vh] w-[30vw] opacity-30"
    style="background:radial-gradient(ellipse at 80% 100%,rgba(255,153,0,0.05) 0%,transparent 60%);"
  ></div>

  <div class="container-sbg relative z-10">
    <!-- Section header -->
    <div class="max-w-3xl mx-auto text-center" data-animate>
      <span class="code-label mb-4 inline-block"># que_es_un_sbg</span>
      <h2
        id="what-is-heading"
        class="text-[2rem] leading-[1.1] sm:text-[2.6rem] lg:text-[3rem]"
      >
        ¿Qué es un <span class="text-[var(--sbg-orange)]">AWS Student Builder Group</span>?
      </h2>
      <p
        class="mt-5 text-base leading-[1.8] text-[var(--sbg-text-muted)] sm:text-lg max-w-2xl mx-auto"
        style="font-family:'Nunito Sans',sans-serif;"
      >
        Es una comunidad universitaria respaldada por Amazon Web Services donde
        estudiantes aprenden, construyen y se certifican en tecnología cloud.
        Somos el puente entre la academia y la industria.
      </p>
    </div>

    <!-- Pillars grid with glow tracking -->
    <div id="whatis-grid" class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {pillars.map((pillar, i) => (
        <div
          data-animate
          data-glow-color={pillar.glowColor}
          class="whatis-card group relative rounded-2xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] p-7 transition-all duration-300 hover:border-[var(--sbg-accent-border)] hover:bg-[var(--sbg-bg-elevated)] hover:shadow-2xl hover:-translate-y-1"
          style={`transition-delay: ${i * 80}ms;`}
        >
          <!-- Cursor-tracking glow overlay -->
          <div
            aria-hidden="true"
            class="whatis-glow pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-500"
          ></div>

          <!-- Border glow effect -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            style={`box-shadow: inset 0 0 30px ${pillar.glowColor.replace('0.4', '0.08')}, 0 0 40px ${pillar.glowColor.replace('0.4', '0.12')};`}
          ></div>

          <!-- Icon -->
          <div class="relative z-10 mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--sbg-accent-subtle)] text-[var(--sbg-accent-light)] transition-all duration-300 group-hover:bg-[var(--sbg-accent)] group-hover:text-white group-hover:shadow-lg group-hover:shadow-[var(--sbg-accent)]/30 group-hover:scale-110">
            <Fragment set:html={pillar.icon} />
          </div>

          <!-- Content -->
          <h3
            class="relative z-10 text-lg font-bold text-white"
            style="font-family:'Space Mono',monospace;"
          >
            {pillar.title}
          </h3>
          <p
            class="relative z-10 mt-2 text-sm leading-relaxed text-[var(--sbg-text-muted)]"
            style="font-family:'Nunito Sans',sans-serif;"
          >
            {pillar.description}
          </p>

          <!-- Decorative corner glow on hover -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -top-px -right-px h-24 w-24 rounded-tr-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            style={`background:radial-gradient(circle at top right,${pillar.glowColor} 0%,transparent 70%);`}
          ></div>

          <!-- Bottom accent line -->
          <div
            aria-hidden="true"
            class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 rounded-full transition-all duration-500 group-hover:w-3/4"
            style={`background: linear-gradient(90deg, transparent, ${pillar.glowColor}, transparent);`}
          ></div>
        </div>
      ))}
    </div>

    <!-- Extra context line -->
    <div class="mt-12 text-center" data-animate>
      <p class="text-sm text-[var(--sbg-text-muted)] italic" style="font-family:'Nunito Sans',sans-serif;">
        Existen más de 1,000 Builder Groups alrededor del mundo. Nosotros somos el capítulo de la Universidad del Valle.
      </p>
    </div>
  </div>
</section>

<script is:inline>
document.addEventListener('astro:page-load', function() {
  var cards = document.querySelectorAll('.whatis-card');
  if (!cards.length) return;

  cards.forEach(function(card) {
    var glow = card.querySelector('.whatis-glow');
    if (!glow) return;
    var color = card.getAttribute('data-glow-color') || 'rgba(139,92,246,0.4)';

    card.addEventListener('mousemove', function(e) {
      var rect = card.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      glow.style.background = 'radial-gradient(350px circle at ' + x + 'px ' + y + 'px, ' + color + ' 0%, transparent 70%)';
      glow.style.opacity = '1';
    });

    card.addEventListener('mouseleave', function() {
      glow.style.opacity = '0';
    });
  });
});
</script>
