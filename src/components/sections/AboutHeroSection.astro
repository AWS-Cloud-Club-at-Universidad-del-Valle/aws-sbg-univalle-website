---
/**
 * AboutHeroSection — Hero banner for the About page.
 *
 * Renders the page title, a code-label, and an introductory paragraph
 * with staggered hero-reveal entrance animations. Includes decorative
 * floating geometric shapes consistent with the site's visual language.
 *
 * Contains the sole <h1> element for the /about page.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section
  aria-labelledby="about-hero-heading"
  class:list={['relative overflow-hidden pt-20 pb-10 lg:pt-28 lg:pb-14', className]}
>
  <!-- Radial gradient backgrounds -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-[60vh]"
    style="background:radial-gradient(ellipse 55% 45% at 30% 0%,rgba(255,153,0,0.08) 0%,transparent 65%);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 right-0 h-[50vh] w-[50vw]"
    style="background:radial-gradient(ellipse at 80% 100%,rgba(35,47,62,0.35) 0%,transparent 60%);"
  ></div>

  <!-- Dot grid pattern -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.025]"
    style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:36px 36px;"
  ></div>

  <!-- Decorative floating geometric shapes -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-16 left-8 h-0 w-0 opacity-20"
    style="border-left: 10px solid transparent; border-right: 10px solid transparent; border-bottom: 18px solid var(--sbg-accent-light); animation: float-triangle 6s ease-in-out infinite;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-20 right-12 h-3 w-3 rounded-full opacity-15"
    style="background: var(--sbg-orange); animation: float-circle 7s ease-in-out infinite;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute top-1/3 right-1/4 h-2 w-2 rounded-full opacity-10"
    style="background: var(--sbg-accent); animation: float-circle 5s ease-in-out infinite 1s;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute hidden sm:block bottom-1/4 left-[15%] h-2.5 w-2.5 opacity-10"
    style="background: var(--sbg-accent); animation: float-square 8s ease-in-out infinite 2s;"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute hidden lg:block top-1/4 right-16 h-3 w-3 opacity-10"
    style="background: var(--sbg-orange); animation: float-rhombus 9s ease-in-out infinite 1.5s;"
  ></div>

  <!-- Content -->
  <div class="container-sbg relative z-10">
    <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-8">
      <!-- Columna izquierda: texto -->
      <div class="max-w-2xl lg:max-w-none">
        <span class="hero-animate hero-animate-delay-1 code-label mb-4 inline-block">
          # about.nosotros
        </span>

        <h1
          id="about-hero-heading"
          class="hero-animate hero-animate-delay-2 text-[2.4rem] leading-[1.08] tracking-tight sm:text-5xl lg:text-[3.2rem]"
        >
          Nosotros
        </h1>

        <p
          class="hero-animate hero-animate-delay-3 mt-5 max-w-lg text-base leading-[1.8] text-[var(--sbg-text-muted)] sm:text-lg"
          style="font-family:'Nunito Sans',sans-serif;"
        >
          Somos la comunidad estudiantil de AWS en la Universidad del Valle. Aprendemos, construimos y conectamos talento con la industria cloud.
        </p>
      </div>

      <!-- Columna derecha: SVG decorativo de arquitectura cloud (solo desktop) -->
      <div class="hidden lg:block pointer-events-none" aria-hidden="true">
        <svg
          viewBox="0 0 300 250"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="w-full h-auto opacity-[0.10]"
        >
          <!-- Líneas de conexión entre nodos -->
          <line x1="60" y1="50" x2="150" y2="30" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="150" y1="30" x2="240" y2="70" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="60" y1="50" x2="90" y2="130" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="150" y1="30" x2="150" y2="120" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="240" y1="70" x2="220" y2="150" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="90" y1="130" x2="150" y2="120" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="150" y1="120" x2="220" y2="150" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="90" y1="130" x2="130" y2="210" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="220" y1="150" x2="180" y2="220" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />
          <line x1="130" y1="210" x2="180" y2="220" stroke="var(--sbg-blue, #1A73E8)" stroke-width="1.5" stroke-linecap="round" />

          <!-- Nodos (círculos) -->
          <!-- Nodo 1: superior izquierda -->
          <circle cx="60" cy="50" r="8" fill="var(--sbg-accent, #8B5CF6)" />
          <!-- Nodo 2: superior centro -->
          <circle cx="150" cy="30" r="10" fill="var(--sbg-orange, #FF9900)" />
          <!-- Nodo 3: superior derecha -->
          <circle cx="240" cy="70" r="7" fill="var(--sbg-accent, #8B5CF6)" />
          <!-- Nodo 4: medio izquierda -->
          <circle cx="90" cy="130" r="9" fill="var(--sbg-orange, #FF9900)" />
          <!-- Nodo 5: centro -->
          <circle cx="150" cy="120" r="12" fill="var(--sbg-accent, #8B5CF6)" />
          <!-- Nodo 6: medio derecha -->
          <circle cx="220" cy="150" r="8" fill="var(--sbg-orange, #FF9900)" />
          <!-- Nodo 7: inferior izquierda -->
          <circle cx="130" cy="210" r="7" fill="var(--sbg-accent, #8B5CF6)" />
          <!-- Nodo 8: inferior derecha -->
          <circle cx="180" cy="220" r="9" fill="var(--sbg-orange, #FF9900)" />
        </svg>
      </div>
    </div>
  </div>
</section>
