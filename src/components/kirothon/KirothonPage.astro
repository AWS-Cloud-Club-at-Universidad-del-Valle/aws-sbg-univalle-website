---
import Countdown from './Countdown.astro';
import Registration from './Registration.astro';
import SectionDivider from '@/components/common/SectionDivider.astro';
import { KIROTHON } from '@/lib/constants';

const steps = [
  ['Requisitos', 'Define qué debe hacer tu solución.'],
  ['Diseño', 'Decide cómo vas a construirla.'],
  ['Tareas', 'Organiza el trabajo que el agente irá ejecutando.'],
];

const rubric = [
  ['Solución y demo', '¿Resuelve un problema real? ¿La demo funciona en vivo, de punta a punta?', 25],
  ['Proceso', 'Decisiones técnicas, cómo se repartieron el trabajo y qué cambiaron cuando algo falló.', 20],
  ['Calidad técnica', 'Claridad del código, decisiones de diseño y facilidad para ejecutar la solución.', 15],
  ['Creatividad', 'Originalidad de la idea y del enfoque.', 15],
  ['Pitch', 'Claridad del problema, la solución y su impacto (solo en la final).', 15],
  ['Validación', 'Comprobaron que la solución cumple lo que promete y reconocen sus límites.', 10],
] as const;

const maxPoints = Math.max(...rubric.map(([, , points]) => points));
---

<div class="kirothon">
  <header class="hero relative pt-20 pb-12 lg:pt-24 lg:pb-16">
    <div class="container-sbg relative grid items-center gap-8 lg:grid-cols-[4fr_6fr] lg:gap-12">
      <div>
        <p class="code-label event-label mb-4">Hackathon presencial</p>
        <h1 class="text-[2.4rem] leading-[1.08] tracking-tight sm:text-5xl lg:text-[4rem]">Kirothon</h1>
        <p class="mt-5 text-lg leading-relaxed sm:text-xl">Construye con <strong class="kiro-underline">Kiro</strong> en equipos de hasta {KIROTHON.teamMax} personas.</p>
        <p class="mt-2">Organiza AWS Student Builder Group Univalle, con el respaldo de Kiro.</p>

        <dl class="hero-facts my-6 grid gap-4">
          <div>
            <dt class="code-label mb-1">Cuándo</dt>
            <dd><time datetime={KIROTHON.date}>{KIROTHON.dateLabel}</time><br />{KIROTHON.hours} (hora de Colombia)</dd>
          </div>
          <div>
            <dt class="code-label mb-1">Dónde</dt>
            <dd>Universidad del Valle, Sede Tuluá<br />Villa Campestre · Presencial</dd>
          </div>
        </dl>
      </div>

      <div class="min-w-0">
        <picture class="cover">
          <source media="(max-width: 639px)" srcset="/kirothon/post-kirothon-1080x1350.png" width="1080" height="1350" />
          <img class="block h-auto w-full" src={KIROTHON.cover} width="1200" height="675" alt="Afiche de la Kirothon: hackathon de Kiro, sábado 19 de diciembre de 2026, Univalle Sede Tuluá." fetchpriority="high" />
        </picture>
        <Countdown />
      </div>
    </div>
  </header>

  <Registration />

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 8 }, () => <span>KIROTHON · TULUÁ · 19 DIC · EQUIPOS DE HASTA {KIROTHON.teamMax} ·</span>)}
    </div>
  </div>

  <section class="container-sbg py-12 lg:py-16" aria-labelledby="specs-title" data-reveal>
    <h2 id="specs-title" class="text-2xl sm:text-3xl">¿Qué es Kiro?</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">Kiro es el IDE agéntico de AWS y trabaja con <strong>specs</strong>. Antes de generar código, convierte tu idea en un plan de tres pasos.</p>
    <div class="terminal mt-6">
      <p class="code-label terminal-label" aria-hidden="true">$ kiro / spec</p>
      <ol class="grid sm:grid-cols-3">
        {steps.map(([name, description], index) => (
          <li class="spec-step" style={`--step-delay: ${index * 450}ms; --letters: ${name.length}`}>
            <span class="code-label step-index" aria-hidden="true">0{index + 1} /</span>
            <h3 class="recap-card__title"><span class="typed-name">{name}</span></h3>
            <p class="mt-2">{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-sbg grid items-start gap-6 pb-12 lg:grid-cols-2 lg:gap-12 lg:pb-16" aria-labelledby="format-title" data-reveal>
    <div>
      <h2 id="format-title" class="text-2xl sm:text-3xl">Cómo funciona</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">Compiten en <strong>equipos de hasta {KIROTHON.teamMax} personas</strong>. Un jurado de 3 personas evalúa los proyectos por sus méritos{KIROTHON.showDeliverablesAndRubric ? ', con la misma rúbrica para todos' : ''}.</p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed sm:text-lg">Los equipos presentan sus proyectos en formato feria. Cinco finalistas presentan en el escenario.</p>
    </div>
    {KIROTHON.showDeliverablesAndRubric && (
      <div class="recap-card lifted deliverables">
        <h3 class="recap-card__title">Qué entrega cada equipo</h3>
        <ul class="recap-feature__list mt-3">
          <li>Un repositorio con instrucciones para ejecutar la solución (a las 5:30 p.m.).</li>
          <li>Una demo funcionando, de punta a punta, para la feria.</li>
          <li>Si clasifican: un pitch de 3 minutos, con 2 minutos de preguntas.</li>
        </ul>
      </div>
    )}
  </section>

  <SectionDivider />

  {KIROTHON.showDeliverablesAndRubric && (<>
  <section class="container-sbg py-12 lg:py-16" aria-labelledby="rubric-title" data-reveal>
    <div class="grid items-start gap-6 lg:grid-cols-[1fr_2fr] lg:gap-12">
      <div>
        <h2 id="rubric-title" class="text-2xl sm:text-3xl">Rúbrica</h2>
        <p class="mt-4"><strong class="rubric-total">100</strong> puntos</p>
      </div>
      <div class="recap-card">
        <table aria-labelledby="rubric-title">
          <thead>
            <tr><th scope="col" class="code-label">Criterio</th><th scope="col" class="code-label">Puntos</th></tr>
          </thead>
          <tbody>
            {rubric.map(([name, description, points]) => (
              <tr data-score-row>
                <th scope="row">
                  <strong>{name}</strong>
                  <span>{description}</span>
                  <div class="score-track" aria-hidden="true">
                    <div class="score-fill" style={`--score: ${points / maxPoints}`}></div>
                  </div>
                </th>
                <td>{points}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <SectionDivider />
  </>)}

  <div class="container-sbg grid gap-4 py-12 md:grid-cols-2 lg:py-16" data-reveal>
    <section class="recap-card lifted" aria-labelledby="awards-title">
      <h2 id="awards-title" class="text-2xl sm:text-3xl">Premios</h2>
      <p class="my-3 text-2xl font-extrabold kiro-underline">1.º <span>·</span> 2.º <span>·</span> 3.º</p>
      <p>Y dos menciones: <strong>Mejor uso de Kiro</strong> y <strong>Mejor pitch</strong>. Puedes construir con las herramientas que quieras: el puesto se gana por el proyecto. Decide el jurado.</p>
    </section>
    <section class="recap-card lifted" aria-labelledby="pending-title">
      <h2 id="pending-title" class="text-2xl sm:text-3xl">Próximamente</h2>
      <p class="mt-3">Lo anunciamos muy pronto. Mantente atento en Meetup:</p>
      <ul class="recap-feature__list mt-3">
        <li>Quiénes serán los jurados.</li>
        <li>Los créditos para cada equipo.</li>
      </ul>
    </section>
  </div>

  <section class="container-sbg pb-16 lg:pb-24" aria-labelledby="event-closing-title" data-reveal>
    <div class="recap-card">
      <h2 id="event-closing-title" class="text-2xl sm:text-3xl">Nos vemos en la Kirothon</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">La Kirothon reúne a 80 constructores para crear con Kiro en equipos de hasta {KIROTHON.teamMax} personas.</p>
      <dl class="my-6 grid gap-4 border-y border-[var(--sbg-border)] py-5 sm:grid-cols-3">
        <div><dt class="code-label mb-1">Cuándo</dt><dd><time datetime={KIROTHON.date}>{KIROTHON.dateLabel}</time><br />{KIROTHON.hours} (hora de Colombia)</dd></div>
        <div><dt class="code-label mb-1">Dónde</dt><dd>Universidad del Valle, Sede Tuluá<br />Villa Campestre · Presencial</dd></div>
        <div><dt class="code-label mb-1">Qué traer</dt><dd>Trae tu laptop. Si ya tienes a tus dos parceros, ¡caigan juntos!</dd></div>
      </dl>
      <a class="recap-btn recap-btn--primary" href="#kiro-step-1">Empezar por Meetup</a>
    </div>
  </section>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const page = document.querySelector('.kirothon');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!page || motion.matches || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('has-entered');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.08 });

    page.querySelectorAll('[data-reveal], [data-score-row]').forEach((element) => observer.observe(element));
    page.querySelector('.marquee-track')?.classList.add('is-moving');

    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  });
</script>

<style>
  .kirothon {
    --kiro-purple: #9046FF;
    --kiro-light: #d9bdff;
    --kiro-mono: 'Space Mono', monospace;
  }

  .hero {
    --grid-line: rgb(255 255 255 / 0.055);
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .kirothon :global(.code-label) {
    font-family: var(--kiro-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-label {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--kiro-purple);
    border-radius: 0.3rem;
    background: var(--sbg-bg-elevated);
    color: #fff;
  }

  .kiro-underline {
    text-decoration: underline 3px var(--kiro-purple);
    text-underline-offset: 0.25em;
  }

  .hero-facts {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--kiro-purple);
  }

  .cover {
    display: block;
    overflow: hidden;
    border: 1px solid var(--kiro-purple);
    border-radius: 0.75rem;
    box-shadow: 6px 6px 0 var(--kiro-purple);
  }

  .marquee {
    display: grid;
    overflow: hidden;
    padding-block: 0.7rem;
    border-block: 1px solid var(--kiro-purple);
    background: var(--sbg-bg-elevated);
    color: #fff;
  }

  .marquee-track {
    display: flex;
    justify-self: center;
    width: max-content;
    font: 700 0.75rem/1.4 var(--kiro-mono);
    letter-spacing: 0.12em;
  }

  .marquee-track span { padding-inline: 0.5ch; }

  .terminal {
    overflow: hidden;
    border: 1px solid var(--sbg-border);
    border-radius: 0.75rem;
    background: var(--sbg-bg-elevated);
  }

  .terminal-label {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--sbg-border);
  }

  .spec-step {
    position: relative;
    padding: 1rem;
    border-inline-start: 2px solid var(--kiro-purple);
  }

  .spec-step + .spec-step { border-top: 1px solid var(--sbg-border); }
  .step-index { display: block; margin-bottom: 0.5rem; }
  .typed-name { display: inline-block; }

  @media (min-width: 640px) {
    .spec-step + .spec-step { border-top: 0; }
  }

  .deliverables {
    border-color: var(--kiro-purple);
    box-shadow: 6px 6px 0 var(--kiro-purple);
  }

  .rubric-total {
    display: inline-block;
    font: 700 clamp(2.5rem, 5vw, 4.5rem)/1 var(--kiro-mono);
    color: var(--kiro-purple);
    vertical-align: middle;
  }

  .score-track {
    height: 0.25rem;
    margin-top: 0.6rem;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--sbg-bg-elevated);
  }

  .score-fill {
    height: 100%;
    border-radius: inherit;
    background: var(--kiro-purple);
    transform: scaleX(var(--score));
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-reveal].has-entered { animation: kiro-enter 460ms ease-out both; }

    .has-entered .typed-name {
      animation: kiro-type 380ms steps(var(--letters)) var(--step-delay) both;
    }

    [data-score-row].has-entered .score-fill {
      animation: kiro-score 650ms ease-out both;
    }

    .marquee-track.is-moving { animation: kiro-tape 4.8s ease-out; }
  }

  @media (hover: hover) {
    .lifted:hover { border-color: var(--kiro-purple); }

    @media (prefers-reduced-motion: no-preference) {
      .lifted { transition: transform 180ms ease-out, border-color 180ms ease-out; }
      .lifted:hover { transform: translateY(-4px); }
    }
  }

  @keyframes kiro-enter {
    from { opacity: 0; transform: translateY(0.85rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes kiro-type {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0); }
  }

  @keyframes kiro-score {
    from { transform: scaleX(0); }
    to { transform: scaleX(var(--score)); }
  }

  @keyframes kiro-tape {
    from { transform: translateX(12.5%); }
    to { transform: translateX(0); }
  }

  table {
    width: 100%;
    text-align: left;
  }

  th, td {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--sbg-border);
  }

  thead th { padding-top: 0; }

  tbody tr:last-child > * {
    padding-bottom: 0;
    border-bottom: 0;
  }

  tbody th { font-weight: 400; }
  tbody th span { display: block; color: var(--sbg-text-muted); }

  thead th:last-child, td {
    padding-left: 0.75rem;
    text-align: right;
  }

  td {
    color: var(--kiro-purple);
    font: 700 1.35rem var(--kiro-mono);
    font-variant-numeric: tabular-nums;
  }

  code {
    padding-inline: 0.25rem;
    border-radius: 0.25rem;
    background: var(--sbg-bg-elevated);
  }
</style>
