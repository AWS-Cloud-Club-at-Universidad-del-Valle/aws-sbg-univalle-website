---
import MeetupLink from './MeetupLink.astro';
import SectionDivider from '@/components/common/SectionDivider.astro';
import { KIROTHON } from '@/lib/constants';

const steps = [
  ['Requisitos', 'Define qué debe hacer tu solución.'],
  ['Diseño', 'Decide cómo vas a construirla.'],
  ['Tareas', 'Organiza el trabajo que el agente irá ejecutando.'],
];

const rubric = [
  ['Solución y demo', 'Qué problema resuelve y si la demo funciona.', 25],
  ['Uso de Kiro', 'Specs, hooks, steering y modo agente.', 20],
  ['Proceso', 'Cómo lo resolvieron y qué decisiones tomaron.', 15],
  ['Creatividad', 'Originalidad de la idea y de su enfoque.', 15],
  ['Pitch', 'Claridad al presentar la solución.', 15],
  ['Eficiencia de créditos', 'Cuánto lograron por cada crédito usado.', 10],
] as const;
---

<div>
  <header class="relative overflow-hidden pt-20 pb-12 lg:pt-24 lg:pb-16">
    <div aria-hidden="true" class="hero-glow pointer-events-none absolute inset-0"></div>
    <div class="container-sbg relative grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="hero-animate hero-animate-delay-1">
        <p class="code-label launch-label mb-4">Meetup de lanzamiento</p>
        <h1 class="text-[2.4rem] leading-[1.08] tracking-tight sm:text-5xl lg:text-[4rem]">Kirothon</h1>
        <p class="mt-5 text-lg leading-relaxed sm:text-xl">La hackathon de <strong class="text-[var(--sbg-accent-light)]">Kiro</strong> en Tuluá.</p>
        <p class="mt-2">Organiza AWS Student Builder Group Univalle.</p>
      </div>

      <div class="recap-card hero-animate hero-animate-delay-2 gap-5">
        <dl class="grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="code-label mb-1">Cuándo</dt>
            <dd><time datetime={KIROTHON.date}>{KIROTHON.dateLabel}</time><br />{KIROTHON.hours}</dd>
          </div>
          <div>
            <dt class="code-label mb-1">Dónde</dt>
            <dd>Universidad del Valle, Sede Tuluá<br />Villa Campestre · Presencial</dd>
          </div>
        </dl>
        <div><MeetupLink /></div>
      </div>
    </div>
  </header>

  <SectionDivider />

  <section class="container-sbg py-12 lg:py-16" aria-labelledby="specs-title">
    <h2 id="specs-title" class="text-2xl sm:text-3xl">¿Qué es Kiro?</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">Kiro es un IDE agéntico que trabaja con <strong>specs</strong>. Antes de generar código, convierte tu idea en un plan de tres pasos.</p>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {steps.map(([name, description], index) => (
        <li class="recap-card">
          <span class="code-label mb-2 text-[var(--sbg-orange)]" aria-hidden="true">0{index + 1}</span>
          <h3 class="recap-card__title">{name}</h3>
          <p class="mt-2">{description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-sbg grid items-start gap-6 pb-12 lg:grid-cols-2 lg:gap-12 lg:pb-16" aria-labelledby="format-title">
    <div>
      <h2 id="format-title" class="text-2xl sm:text-3xl">Cómo funciona</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">Compiten en <strong>equipos de 3 personas</strong>. Un jurado de 3 personas evalúa las entregas.</p>
    </div>
    <div class="recap-card">
      <h3 class="recap-card__title">Qué entrega cada equipo</h3>
      <ul class="recap-feature__list mt-3">
        <li>Un repositorio con la carpeta <code>.kiro/</code> y al menos un spec.</li>
        <li>Una demo funcionando.</li>
        <li>Un pitch de 3 minutos, con 2 minutos de preguntas.</li>
      </ul>
    </div>
  </section>

  <SectionDivider />

  <section class="container-sbg py-12 lg:py-16" aria-labelledby="rubric-title">
    <div class="grid items-start gap-6 lg:grid-cols-[1fr_2fr] lg:gap-12">
      <div>
        <h2 id="rubric-title" class="text-2xl sm:text-3xl">Rúbrica</h2>
        <p class="mt-4"><strong class="text-3xl text-[var(--sbg-accent-light)]">100</strong> puntos</p>
      </div>
      <div class="recap-card">
        <table aria-labelledby="rubric-title">
          <thead>
            <tr><th scope="col" class="code-label">Criterio</th><th scope="col" class="code-label">Puntos</th></tr>
          </thead>
          <tbody>
            {rubric.map(([name, description, points]) => (
              <tr>
                <th scope="row"><strong>{name}</strong><span>{description}</span></th>
                <td>{points}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <SectionDivider />

  <div class="container-sbg grid gap-4 py-12 md:grid-cols-2 lg:py-16">
    <section class="recap-card" aria-labelledby="awards-title">
      <h2 id="awards-title" class="text-2xl sm:text-3xl">Premios</h2>
      <p class="my-3 text-2xl font-extrabold text-[var(--sbg-accent-light)]">1.º <span>·</span> 2.º <span>·</span> 3.º</p>
      <p>Habrá menciones a <strong>Mejor uso de Kiro</strong> y <strong>Mejor pitch</strong>. El voto del público es opcional y se considera aparte.</p>
    </section>
    <section class="recap-card" aria-labelledby="pending-title">
      <h2 id="pending-title" class="text-2xl sm:text-3xl">Por confirmar</h2>
      <ul class="recap-feature__list mt-3">
        <li>Fecha y duración de la hackathon.</li>
        <li>Integrantes del jurado.</li>
        <li>Créditos por equipo.</li>
      </ul>
    </section>
  </div>

  <section class="container-sbg pb-16 lg:pb-24" aria-labelledby="launch-title">
    <div class="recap-card">
      <h2 id="launch-title" class="text-2xl sm:text-3xl">Nos vemos en el lanzamiento</h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">Te contamos cómo va a ser la hackathon, armamos equipos de 3 y probamos Kiro en vivo. El cupo aproximado es de 60 a 80 personas.</p>
      <dl class="my-6 grid gap-4 border-y border-[var(--sbg-border)] py-5 sm:grid-cols-3">
        <div><dt class="code-label mb-1">Cuándo</dt><dd><time datetime={KIROTHON.date}>{KIROTHON.dateLabel}</time><br />{KIROTHON.hours}</dd></div>
        <div><dt class="code-label mb-1">Dónde</dt><dd>Universidad del Valle, Sede Tuluá<br />Villa Campestre · Presencial</dd></div>
        <div><dt class="code-label mb-1">Qué traer</dt><dd>Tu laptop.</dd></div>
      </dl>
      <div><MeetupLink /></div>
      <details class="mt-6">
        <summary class="w-fit cursor-pointer text-sm text-[var(--sbg-accent-light)]">Ver afiche del lanzamiento</summary>
        <picture class="mt-4 block max-w-2xl overflow-hidden rounded-xl border border-[var(--sbg-border)]">
          <source media="(max-width: 639px)" srcset="/kirothon/post-meetup-1080x1350.png" width="1080" height="1350" />
          <img loading="lazy" class="h-auto w-full" src={KIROTHON.cover} width="1200" height="675" alt="Afiche del meetup de lanzamiento de la Kirothon, con los datos del encuentro y los logos de AWS y del grupo estudiantil." />
        </picture>
      </details>
    </div>
  </section>
</div>

<style>
  .hero-glow {
    background: radial-gradient(ellipse 60% 50% at 15% 0%, rgba(139, 92, 246, 0.16) 0%, transparent 60%),
      radial-gradient(ellipse 50% 45% at 95% 30%, rgba(255, 153, 0, 0.1) 0%, transparent 60%);
  }

  .launch-label {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    border: 1px solid color-mix(in srgb, #9046ff 45%, transparent);
    border-radius: 999px;
    background: var(--sbg-accent-subtle);
    color: var(--sbg-accent-light);
  }

  table {
    width: 100%;
    text-align: left;
  }

  th, td {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--sbg-border);
  }

  thead th { padding-top: 0; }

  tbody tr:last-child > * {
    padding-bottom: 0;
    border-bottom: 0;
  }

  tbody th { font-weight: 400; }
  tbody th span { display: block; color: var(--sbg-text-muted); }

  thead th:last-child, td {
    padding-left: 0.75rem;
    text-align: right;
  }

  td {
    color: var(--sbg-accent-light);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  code {
    padding-inline: 0.25rem;
    border-radius: 0.25rem;
    background: var(--sbg-bg-elevated);
  }
</style>
