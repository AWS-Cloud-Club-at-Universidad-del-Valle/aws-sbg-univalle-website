---
import MeetupLink from './MeetupLink.astro';
import { KIROTHON } from '@/lib/constants';

const steps = [
  ['Requisitos', 'Define qué debe hacer tu solución.'],
  ['Diseño', 'Decide cómo vas a construirla.'],
  ['Tareas', 'Organiza el trabajo que el agente irá ejecutando.'],
];

const rubric = [
  ['Solución y demo', 'Qué problema resuelve y si la demo funciona.', 25],
  ['Uso de Kiro', 'Specs, hooks, steering y modo agente.', 20],
  ['Proceso', 'Cómo lo resolvieron y qué decisiones tomaron.', 15],
  ['Creatividad', 'Originalidad de la idea y de su enfoque.', 15],
  ['Pitch', 'Claridad al presentar la solución.', 15],
  ['Eficiencia de créditos', 'Cuánto lograron por cada crédito usado.', 10],
] as const;
---

<div class="kirothon">
  <header class="dark">
    <div class="frame hero">
      <div>
        <p class="label accent">Meetup de lanzamiento</p>
        <h1>Kirothon</h1>
        <p class="tagline">La hackathon de <strong class="accent">Kiro</strong> en Tuluá.</p>
        <p class="organizer">Organiza AWS Student Builder Group Univalle.</p>
        <dl class="hero-facts">
          <div>
            <dt class="label">Cuándo</dt>
            <dd><time datetime={KIROTHON.date}>{KIROTHON.dateLabel}</time><br />{KIROTHON.hours}</dd>
          </div>
          <div>
            <dt class="label">Dónde</dt>
            <dd>Universidad del Valle, Sede Tuluá<br />Villa Campestre · Presencial</dd>
          </div>
        </dl>
        <MeetupLink />
      </div>
      <picture class="cover">
        <source media="(max-width: 639px)" srcset="/kirothon/post-meetup-1080x1350.png" width="1080" height="1350" />
        <img src={KIROTHON.cover} width="1200" height="675" alt="Afiche del meetup de lanzamiento de la Kirothon, con los datos del encuentro y los logos de AWS y del grupo estudiantil." />
      </picture>
    </div>
  </header>

  <section class="frame band" aria-labelledby="specs-title">
    <h2 id="specs-title">¿Qué es Kiro?</h2>
    <p class="intro">Kiro es un IDE agéntico que trabaja con <strong>specs</strong>. Antes de generar código, convierte tu idea en un plan de tres pasos.</p>
    <ol class="steps">
      {steps.map(([name, description], index) => (
        <li class="card">
          <span class="step-number" aria-hidden="true">0{index + 1}</span>
          <h3>{name}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="frame band format" aria-labelledby="format-title">
    <div>
      <h2 id="format-title">Cómo funciona</h2>
      <p class="intro">Compiten en <strong>equipos de 3 personas</strong>. Un jurado de 3 personas evalúa las entregas.</p>
    </div>
    <div class="card deliverables">
      <h3>Qué entrega cada equipo</h3>
      <ul>
        <li>Un repositorio con la carpeta <code>.kiro/</code> y al menos un spec.</li>
        <li>Una demo funcionando.</li>
        <li>Un pitch de 3 minutos, con 2 minutos de preguntas.</li>
      </ul>
    </div>
  </section>

  <section class="dark" aria-labelledby="rubric-title">
    <div class="frame band scoring">
      <div>
        <h2 id="rubric-title">Rúbrica</h2>
        <p class="rubric-total"><strong class="accent">100</strong> puntos</p>
      </div>
      <table aria-labelledby="rubric-title">
        <thead>
          <tr><th scope="col" class="label">Criterio</th><th scope="col" class="label">Puntos</th></tr>
        </thead>
        <tbody>
          {rubric.map(([name, description, points]) => (
            <tr>
              <th scope="row"><strong>{name}</strong><span>{description}</span></th>
              <td>{points}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <div class="frame band awards">
    <section aria-labelledby="awards-title">
      <h2 id="awards-title">Premios</h2>
      <p class="podium">1.º <span>·</span> 2.º <span>·</span> 3.º</p>
      <p>Habrá menciones a <strong>Mejor uso de Kiro</strong> y <strong>Mejor pitch</strong>. El voto del público es opcional y se considera aparte.</p>
    </section>
    <section class="card" aria-labelledby="pending-title">
      <h2 id="pending-title">Por confirmar</h2>
      <ul>
        <li>Fecha y duración de la hackathon.</li>
        <li>Integrantes del jurado.</li>
        <li>Créditos por equipo.</li>
      </ul>
    </section>
  </div>

  <section class="dark" aria-labelledby="launch-title">
    <div class="frame band">
      <h2 id="launch-title">Nos vemos en el lanzamiento</h2>
      <p class="intro">Te contamos cómo va a ser la hackathon, armamos equipos de 3 y probamos Kiro en vivo. El cupo aproximado es de 60 a 80 personas.</p>
      <dl class="launch-facts">
        <div><dt class="label accent">Cuándo</dt><dd><time datetime={KIROTHON.date}>{KIROTHON.dateLabel}</time><br />{KIROTHON.hours}</dd></div>
        <div><dt class="label accent">Dónde</dt><dd>Universidad del Valle, Sede Tuluá<br />Villa Campestre · Presencial</dd></div>
        <div><dt class="label accent">Qué traer</dt><dd>Tu laptop.</dd></div>
      </dl>
      <MeetupLink />
    </div>
  </section>
</div>

<style>
  .kirothon {
    --purple: #9046ff;
    position: relative;
    z-index: 2;
    background: #fff;
    color: #000;
    overflow-wrap: break-word;
  }

  .dark { background: #000; color: #fff; }
  .accent { color: var(--purple); }
  .frame { width: min(100% - 3rem, 74rem); margin-inline: auto; }
  .band { padding-block: clamp(2.75rem, 6vw, 5rem); }
  .label {
    font: 700 .875rem/1.5 'Space Mono', monospace;
    text-transform: uppercase;
    letter-spacing: .14em;
  }

  h1, h2, h3 { color: inherit; }
  h1 { font-size: clamp(2.75rem, 7vw, 7rem); letter-spacing: -.08em; }
  h2 { font-size: clamp(1.65rem, 3.5vw, 2.7rem); }
  h3 { font-size: 1.15rem; }
  .tagline { margin-top: .75rem; font-size: clamp(1.25rem, 2.5vw, 1.8rem); }
  .organizer { margin-top: .4rem; color: #ccc; }

  .hero, .steps, .format, .scoring, .awards, .launch-facts { display: grid; gap: 1.5rem; }
  .hero { align-items: center; padding-block: clamp(2.75rem, 7vw, 6rem); gap: 2.5rem; }
  .hero-facts { margin-block: 1.5rem; padding-block: 1rem; border-block: 1px solid #525252; }
  .hero-facts > div + div { margin-top: .8rem; }
  dd { margin-top: .3rem; }

  .cover { display: block; min-width: 0; box-shadow: 8px 8px 0 var(--purple); border: 1px solid #525252; }
  .cover img { display: block; width: 100%; height: auto; }

  .intro { max-width: 60ch; margin-top: .9rem; font-size: 1.125rem; }
  .steps { margin-top: 1.5rem; padding: 0; list-style: none; }
  .card { background: #fff; border: 2px solid #000; padding: 1.25rem; box-shadow: 8px 8px 0 var(--purple); }
  .card p { margin-top: .5rem; }
  .step-number { display: block; margin-bottom: .5rem; font: 700 1.1rem 'Space Mono', monospace; }
  .format { padding-top: 0; }
  .deliverables { background: #f5f5f5; box-shadow: 8px 8px 0 #000; }
  .card ul { margin-top: .9rem; padding-left: 1.2rem; list-style: square; }
  .card li + li { margin-top: .4rem; }
  code { font-family: 'Space Mono', monospace; background: #e5e5e5; padding-inline: .25rem; }

  .rubric-total { font-family: 'Space Mono', monospace; }
  .rubric-total strong { font-size: clamp(2rem, 5vw, 4rem); }
  table { width: 100%; text-align: left; border-collapse: collapse; }
  th, td { padding: .75rem 0; border-bottom: 1px solid #525252; }
  tbody th { font-weight: 400; }
  tbody th span { display: block; color: #ccc; }
  thead th:last-child, td { padding-left: .75rem; text-align: right; }
  td { color: var(--purple); font: 700 1.3rem 'Space Mono', monospace; }

  .podium { margin-block: .6rem; font: 700 clamp(1.5rem, 4vw, 2.5rem) 'Space Mono', monospace; }
  .podium span { color: var(--purple); }
  .launch-facts { margin-block: 1.5rem; border-block: 1px solid #525252; padding-block: 1.25rem; }

  @media (min-width: 640px) {
    .steps, .launch-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .format, .awards, .scoring { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
  }

  @media (min-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
  }
</style>
