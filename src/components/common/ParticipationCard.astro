---
/**
 * ParticipationCard — Tarjeta de una forma de participar en la comunidad.
 *
 * Muestra icono, título, descripción y un botón de acción. El botón no
 * navega: dispara el evento global `participate:select` con el tipo de
 * propuesta, para que el formulario se preseleccione y reciba foco.
 *
 * Estética alineada con ResourceCard: fondo surface, borde, hover con
 * elevación y glow que sigue el cursor.
 */
import type { IParticipationWay } from '@/types/index';

interface Props {
  way: IParticipationWay;
}

const { way } = Astro.props;
const { key, icon, title, description, actionLabel, glowColor = 'rgba(139,92,246,0.35)' } = way;
---

<article class="participation-card group" data-animate data-glow-color={glowColor}>
  <!-- Glow que sigue el cursor -->
  <div
    aria-hidden="true"
    class="participation-glow pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-500"
  ></div>

  <!-- Línea de acento inferior -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 rounded-full transition-all duration-500 group-hover:w-2/3"
    style={`background: linear-gradient(90deg, transparent, ${glowColor}, transparent);`}
  ></div>

  <div class="card-wrapper">
    <div class="card-icon" aria-hidden="true" style={`--icon-glow:${glowColor};`}>
      {icon === 'mic' && (
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>
        </svg>
      )}
      {icon === 'tools' && (
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      )}
      {icon === 'book' && (
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
        </svg>
      )}
      {icon === 'hand' && (
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 11V6a2 2 0 0 0-2-2 2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2 2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2 2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
        </svg>
      )}
      {!['mic','tools','book','hand'].includes(icon) && (
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
        </svg>
      )}
    </div>

    <h3 class="card-title">{title}</h3>

    <p class="card-description">{description}</p>

    <button
      type="button"
      class="card-action"
      data-proposal-type={key}
      aria-label={`${actionLabel}: ${title}`}
    >
      {actionLabel}
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="action-icon"
      >
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>
  </div>
</article>

<style>
  .participation-card {
    position: relative;
    overflow: hidden;
    background: rgba(33, 37, 46, 0.6);
    border: 1px solid var(--sbg-border);
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    transition: all 300ms ease-out;
  }
  .participation-card:hover {
    background: var(--sbg-bg-surface);
    border-color: var(--sbg-accent-border);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  .participation-card:focus-within {
    outline: 2px solid var(--sbg-accent);
    outline-offset: 3px;
  }
  .card-wrapper {
    position: relative;
    z-index: 10;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }
  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.85rem;
    color: #fff;
    background: linear-gradient(135deg, var(--sbg-orange), var(--sbg-accent));
    box-shadow: 0 8px 20px var(--icon-glow, rgba(139, 92, 246, 0.25));
    transition: transform 300ms ease-out;
  }
  .participation-card:hover .card-icon {
    transform: scale(1.08) rotate(-3deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .card-icon { transition: none; }
    .participation-card:hover .card-icon { transform: none; }
  }
  .card-title {
    font-size: 1.125rem;
    margin: 0;
  }
  .card-description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--sbg-text-muted);
    margin: 0;
  }
  .card-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    align-self: flex-start;
    margin-top: auto;
    min-height: 44px;
    padding: 0.625rem 1.1rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: linear-gradient(90deg, var(--sbg-orange), var(--sbg-accent));
    border: none;
    border-radius: 0.625rem;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(255, 153, 0, 0.18);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out;
  }
  .card-action:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(255, 153, 0, 0.3);
  }
  .card-action:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .action-icon {
    transition: transform 200ms ease-out;
  }
  .card-action:hover .action-icon {
    transform: translateX(2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .participation-card,
    .card-action,
    .action-icon {
      transition: none;
    }
    .participation-card:hover {
      transform: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', function () {
    var cards = document.querySelectorAll('.participation-card');
    if (!cards.length) return;

    cards.forEach(function (card) {
      var glow = card.querySelector('.participation-glow');
      var color = card.getAttribute('data-glow-color') || 'rgba(139,92,246,0.35)';

      if (glow) {
        card.addEventListener('mousemove', function (e) {
          var rect = card.getBoundingClientRect();
          var x = e.clientX - rect.left;
          var y = e.clientY - rect.top;
          glow.style.background =
            'radial-gradient(280px circle at ' + x + 'px ' + y + 'px, ' + color + ' 0%, transparent 70%)';
          glow.style.opacity = '1';
        });
        card.addEventListener('mouseleave', function () {
          glow.style.opacity = '0';
        });
      }

      var btn = card.querySelector('.card-action');
      if (btn) {
        btn.addEventListener('click', function () {
          var type = btn.getAttribute('data-proposal-type') || 'TALK';
          document.dispatchEvent(
            new CustomEvent('participate:select', { detail: { type: type } })
          );
        });
      }
    });
  });
</script>
