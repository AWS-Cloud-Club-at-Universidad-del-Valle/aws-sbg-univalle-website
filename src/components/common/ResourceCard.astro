---
/**
 * ResourceCard — Tarjeta visual para un recurso educativo de AWS.
 *
 * Renderiza icono SVG, badge de categoría, título, descripción y enlace externo.
 * Cursor-tracking glow idéntico al de TeamMemberCard.
 * Usa data-animate para animación de entrada al scroll via IntersectionObserver.
 */
import type { IResource } from '@/types/index';

interface Props {
  resource: IResource;
  accentColor: string;
  glowColor?: string;
}

const { resource, accentColor, glowColor = 'rgba(139,92,246,0.35)' } = Astro.props;
const { title, description, url, category, icon } = resource;
---

<article
  class="resource-card group"
  data-animate
  data-glow-color={glowColor}
>
  <!-- Cursor-tracking glow -->
  <div aria-hidden="true" class="resource-glow pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-500"></div>

  <!-- Outer glow on hover -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style={`box-shadow: 0 0 30px ${glowColor.replace('0.35', '0.1')}, inset 0 0 20px ${glowColor.replace('0.35', '0.05')};`}
  ></div>

  <!-- Bottom accent line -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 rounded-full transition-all duration-500 group-hover:w-2/3"
    style={`background: linear-gradient(90deg, transparent, ${glowColor}, transparent);`}
  ></div>

  <div class="card-wrapper">
    <!-- Icono SVG inline coloreado con accentColor -->
    <div class="icon-container">
      {icon === 'skill-builder' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill={accentColor}>
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
      )}
      {icon === 'academy' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill={accentColor}>
          <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" />
        </svg>
      )}
      {icon === 'certification' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill={accentColor}>
          <path d="M12 2C9.24 2 7 4.24 7 7c0 2.1 1.3 3.9 3.15 4.65L9 22l3-2 3 2-1.15-10.35C15.7 10.9 17 9.1 17 7c0-2.76-2.24-5-5-5zm0 8a3 3 0 110-6 3 3 0 010 6z" />
        </svg>
      )}
      {icon === 'workshops' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill={accentColor}>
          <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" />
        </svg>
      )}
      {icon === 'builder-center' && (
        <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill={accentColor}>
          <path d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm8-2h8v8h-8v-8zm2 2v4h4v-4h-4z" />
        </svg>
      )}
      {(!icon || !['skill-builder', 'academy', 'certification', 'workshops', 'builder-center'].includes(icon)) && (
        <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill={accentColor}>
          <circle cx="12" cy="12" r="10" />
        </svg>
      )}
    </div>

    <!-- Badge de categoría -->
    <span class="category-badge">{category}</span>

    <!-- Título -->
    <h3 class="card-title">{title}</h3>

    <!-- Descripción -->
    <p class="card-description">{description}</p>

    <!-- Enlace externo -->
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Visitar ${title} (abre en nueva pestaña)`}
      class="card-link"
    >
      Visitar recurso
      <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="link-icon">
        <path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zM5 5v14h14v-7h-2v5H7V7h5V5H5z" />
      </svg>
      <span class="sr-only">(abre en nueva pestaña)</span>
    </a>
  </div>
</article>

<style>
  .resource-card {
    position: relative; overflow: hidden;
    background: rgba(33, 37, 46, 0.6);
    border: 1px solid var(--sbg-border); border-radius: 0.75rem;
    display: flex; flex-direction: column;
    width: 100%;
    transition: all 300ms ease-out;
  }
  .resource-card:hover {
    background: var(--sbg-bg-surface);
    border-color: var(--sbg-accent-border);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  .resource-card:focus-within { outline: 2px solid var(--sbg-accent); outline-offset: 3px; }
  .card-wrapper {
    position: relative; z-index: 10;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .icon-container { margin-bottom: 0.25rem; }
  .category-badge {
    display: inline-block;
    align-self: flex-start;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--sbg-text-muted);
  }
  .card-title { font-size: 1.125rem; margin: 0; }
  .card-description { font-size: 0.875rem; line-height: 1.6; color: var(--sbg-text-muted); margin: 0; }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    padding: 0.625rem 0;
    min-height: 44px;
    min-width: 44px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sbg-accent-light);
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .card-link:hover { color: var(--sbg-accent); }
  .link-icon { flex-shrink: 0; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .resource-card { transition: none; }
    .resource-card:hover { transform: none; }
  }
</style>

<script is:inline>
document.addEventListener('astro:page-load', function() {
  var cards = document.querySelectorAll('.resource-card');
  if (!cards.length) return;

  cards.forEach(function(card) {
    var glow = card.querySelector('.resource-glow');
    if (!glow) return;
    var color = card.getAttribute('data-glow-color') || 'rgba(139,92,246,0.35)';

    card.addEventListener('mousemove', function(e) {
      var rect = card.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      glow.style.background = 'radial-gradient(280px circle at ' + x + 'px ' + y + 'px, ' + color + ' 0%, transparent 70%)';
      glow.style.opacity = '1';
    });

    card.addEventListener('mouseleave', function() {
      glow.style.opacity = '0';
    });
  });
});
</script>
