---
/**
 * TeamMemberCard — Tarjeta visual amplia para un integrante del Core Team.
 *
 * Avatar prominente (96px) con soporte condicional de imagen/placeholder,
 * nombre destacado, cargo, badge de área, y enlaces sociales integrados.
 * Preparado para recibir imágenes desde S3 en el futuro.
 */
import type { ICoreTeamMember } from '@/types/index';

interface Props {
  member: ICoreTeamMember;
  class?: string;
}

const { member, class: className } = Astro.props;

function getInitials(name: string): string {
  const parts = name.split(' ');
  const first = parts[0]?.[0] ?? '';
  const last = parts[parts.length - 1]?.[0] ?? '';
  return (first + last).toUpperCase();
}

const initials = getInitials(member.name);
const hasImage = member.image && member.image.trim().length > 0;
---

<article class:list={['team-card', className]} data-animate>
  <div aria-hidden="true" class="card-decoration"></div>

  {hasImage ? (
    <img src={member.image} alt="" aria-hidden="true" class="avatar avatar-img" loading="lazy" />
  ) : (
    <div aria-hidden="true" class="avatar avatar-placeholder">
      <span>{initials}</span>
    </div>
  )}

  <h3 class="card-name">{member.name}</h3>
  <p class="card-role">{member.role}</p>
  <span class="card-area-badge">{member.area}</span>

  <div class="social-links">
    <a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${member.name}`} class="social-link">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      <span class="sr-only">(abre en nueva pestaña)</span>
    </a>
    <a href={member.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub de ${member.name}`} class="social-link">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
      </svg>
      <span class="sr-only">(abre en nueva pestaña)</span>
    </a>
  </div>
</article>

<style>
  .team-card {
    position: relative; overflow: hidden;
    background: var(--sbg-bg-surface); border: 1px solid var(--sbg-border); border-radius: 0.75rem;
    padding: 1.75rem; display: flex; flex-direction: column; align-items: center;
    text-align: center; gap: 0.5rem;
    min-width: 320px; max-width: 360px;
    transition: transform 300ms ease-out, box-shadow 300ms ease-out, border-color 300ms ease-out;
  }
  .team-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
    border-color: var(--sbg-accent-border);
  }
  .team-card:focus-within { outline: 2px solid var(--sbg-accent); outline-offset: 3px; }
  .card-decoration {
    position: absolute; top: 0; right: 0; width: 80px; height: 80px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), transparent);
    border-radius: 0 0.75rem 0 100%; pointer-events: none;
  }
  .avatar { width: 96px; height: 96px; border-radius: 50%; margin-bottom: 0.5rem; }
  .avatar-placeholder {
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--sbg-accent), var(--sbg-orange));
    font-family: 'Space Mono', monospace; font-weight: 700; font-size: 1.75rem; color: white;
  }
  .avatar-img { aspect-ratio: 1 / 1; object-fit: cover; }
  .card-name { font-size: 1.15rem; margin: 0; }
  .card-role { font-size: 0.85rem; color: var(--sbg-text-muted); margin: 0; }
  .card-area-badge {
    display: inline-block; font-family: 'Space Mono', monospace;
    font-size: 0.68rem; letter-spacing: 0.03em; padding: 0.3rem 0.85rem;
    border-radius: 9999px; background: var(--sbg-accent-subtle); color: var(--sbg-text-muted);
    margin-top: 0.25rem;
  }
  .social-links { display: flex; gap: 0.75rem; margin-top: 0.75rem; }
  .social-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px; padding: 0.5rem; border-radius: 0.5rem;
    color: var(--sbg-text-subtle); text-decoration: none;
    transition: color 200ms ease-out, background 200ms ease-out;
  }
  .social-link:hover { color: var(--sbg-accent-light); background: rgba(139, 92, 246, 0.08); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card { transition: none; }
    .team-card:hover { transform: none; }
    .social-link { transition: none; }
  }
</style>
