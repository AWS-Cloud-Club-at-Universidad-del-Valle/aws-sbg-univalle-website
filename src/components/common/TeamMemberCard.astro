---
/**
 * TeamMemberCard — Tarjeta vertical para un integrante del Core Team.
 *
 * Layout vertical: foto prominente arriba, info debajo.
 * Cursor-tracking glow, línea accent inferior, hover interactivo.
 * Fotografías servidas desde CloudFront/S3.
 */
import type { ICoreTeamMember } from '@/types/index';
import { BUILDER_CENTER_PROFILE_BASE } from '@/lib/constants';

interface Props {
  member: ICoreTeamMember;
  glowColor?: string;
  class?: string;
}

const { member, glowColor = 'rgba(139,92,246,0.35)', class: className } = Astro.props;

/** URL del perfil de Builder Center, si el miembro tiene username. */
const builderCenterURL = member.builderCenter
  ? `${BUILDER_CENTER_PROFILE_BASE}${member.builderCenter}`
  : null;


function getInitials(name: string): string {
  const parts = name.split(' ');
  const first = parts[0]?.[0] ?? '';
  const last = parts[parts.length - 1]?.[0] ?? '';
  return (first + last).toUpperCase();
}

const initials = getInitials(member.name);
const hasImage = member.image && member.image.trim().length > 0;
---

<article
  class:list={['team-card group', className]}
  data-animate
  data-glow-color={glowColor}
>
  <!-- Cursor-tracking glow -->
  <div aria-hidden="true" class="team-glow pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-500"></div>

  <!-- Outer glow on hover -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style={`box-shadow: 0 0 30px ${glowColor.replace('0.35', '0.1')}, inset 0 0 20px ${glowColor.replace('0.35', '0.05')};`}
  ></div>

  <!-- Photo area -->
  <div class="relative z-10 card-photo-wrapper">
    {hasImage ? (
      <img
        src={member.image}
        alt={`Fotografía de ${member.name}`}
        class="card-photo"
        loading="lazy"
      />
    ) : (
      <div class="card-photo-placeholder">
        <span>{initials}</span>
      </div>
    )}
  </div>

  <!-- Info -->
  <div class="relative z-10 card-info">
    <h3 class="card-name">{member.name}</h3>
    {member.role && <span class="card-role-badge">{member.role}</span>}
    {member.area && <span class="card-area-badge">{member.area}</span>}

    <div class="social-links-wrapper">
      {(member.linkedin || member.github || builderCenterURL) && (
        <div class="social-links">
          {member.linkedin && (
            <a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${member.name}`} class="social-link">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              <span class="sr-only">(abre en nueva pestaña)</span>
            </a>
          )}
          {member.github && (
            <a href={member.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub de ${member.name}`} class="social-link">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
              <span class="sr-only">(abre en nueva pestaña)</span>
            </a>
          )}
          {builderCenterURL && (
            <a href={builderCenterURL} target="_blank" rel="noopener noreferrer" aria-label={`Perfil de ${member.name} en AWS Builder Center`} class="social-link social-link--aws">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M6.76 10.27c0 .3.03.54.09.72.06.18.15.37.27.58.04.07.06.13.06.18 0 .08-.05.16-.15.24l-.5.33a.38.38 0 0 1-.2.07c-.08 0-.16-.04-.24-.11a2.5 2.5 0 0 1-.29-.38 6.3 6.3 0 0 1-.25-.48c-.62.73-1.4 1.1-2.34 1.1-.67 0-1.2-.2-1.59-.58a2 2 0 0 1-.59-1.53c0-.66.23-1.2.7-1.6.47-.42 1.1-.63 1.9-.63.26 0 .53.02.82.06.28.04.58.1.89.17v-.57c0-.6-.13-1.02-.37-1.26-.25-.24-.68-.36-1.3-.36-.28 0-.57.03-.87.1a6.4 6.4 0 0 0-.87.28 2.3 2.3 0 0 1-.28.1.5.5 0 0 1-.13.03c-.11 0-.17-.08-.17-.25v-.4c0-.13.02-.22.06-.28a.6.6 0 0 1 .23-.17c.28-.14.62-.27 1.02-.37.4-.1.82-.15 1.27-.15.97 0 1.68.22 2.13.66.45.44.67 1.11.67 2.01v2.65zm-3.23 1.21c.26 0 .53-.05.81-.14.28-.1.53-.27.74-.5.13-.15.22-.32.27-.5.05-.19.08-.41.08-.68v-.33a6.5 6.5 0 0 0-.71-.13 5.9 5.9 0 0 0-.73-.05c-.52 0-.9.1-1.16.31-.25.2-.38.5-.38.87 0 .35.09.61.27.79.18.18.44.27.79.27zm6.39.86c-.15 0-.25-.03-.32-.08-.07-.05-.13-.16-.18-.31L7.68 5.65a1.4 1.4 0 0 1-.07-.32c0-.13.06-.2.19-.2h.78c.16 0 .27.03.33.08.07.05.12.16.17.31l1.36 5.36 1.26-5.36c.04-.16.09-.26.16-.31a.57.57 0 0 1 .34-.08h.63c.16 0 .27.03.34.08.07.05.13.16.16.31l1.28 5.42 1.4-5.42c.05-.16.11-.26.17-.31a.55.55 0 0 1 .33-.08h.74c.13 0 .2.06.2.2 0 .04 0 .08-.02.13a1.16 1.16 0 0 1-.05.2l-1.95 6.3c-.05.16-.11.26-.18.31a.54.54 0 0 1-.32.08h-.68c-.16 0-.27-.03-.34-.08-.07-.06-.13-.16-.16-.32l-1.25-5.22-1.24 5.21c-.04.16-.09.26-.16.32-.07.05-.19.08-.34.08h-.68zm10.24.21c-.42 0-.84-.05-1.24-.15-.4-.1-.72-.2-.93-.32a.58.58 0 0 1-.25-.23.58.58 0 0 1-.05-.23v-.42c0-.17.06-.25.18-.25a.4.4 0 0 1 .14.03l.19.08c.26.11.54.2.84.26.3.06.6.09.9.09.48 0 .85-.08 1.1-.25.26-.17.39-.41.39-.72a.65.65 0 0 0-.18-.47c-.12-.13-.35-.24-.68-.35l-.98-.3c-.5-.16-.86-.39-1.08-.69a1.6 1.6 0 0 1-.34-.98c0-.28.06-.53.18-.75.12-.21.28-.4.49-.55.2-.15.44-.26.72-.34.28-.08.57-.11.88-.11.15 0 .31.01.46.03.16.02.3.05.44.08l.4.1c.13.04.23.08.3.12.1.06.17.12.21.19.04.06.06.15.06.26v.39c0 .17-.06.26-.18.26a.83.83 0 0 1-.3-.1 3.6 3.6 0 0 0-1.5-.3c-.44 0-.78.07-1.01.22-.24.14-.35.36-.35.66 0 .2.07.36.2.49.14.13.39.26.75.37l.96.3c.5.16.85.38 1.06.66.21.28.31.6.31.96 0 .29-.06.55-.18.78-.12.23-.29.43-.5.59-.22.16-.47.28-.77.36-.31.09-.63.13-.98.13z"/>
                <path d="M21.7 18.5c-2.62 1.94-6.42 2.97-9.7 2.97-4.58 0-8.72-1.7-11.85-4.52-.25-.22-.03-.53.27-.36 3.38 1.96 7.55 3.15 11.86 3.15 2.9 0 6.1-.6 9.03-1.85.44-.19.81.29.38.61z"/>
                <path d="M22.79 17.26c-.34-.43-2.22-.2-3.06-.1-.26.03-.3-.19-.06-.35 1.5-1.06 3.97-.75 4.26-.4.29.36-.08 2.84-1.49 4.02-.21.18-.42.08-.32-.15.32-.78 1.02-2.52.67-3.02z"/>
              </svg>
              <span class="sr-only">AWS Builder Center (abre en nueva pestaña)</span>
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Bottom accent line -->
  <div
    aria-hidden="true"
    class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 rounded-full transition-all duration-500 group-hover:w-2/3"
    style={`background: linear-gradient(90deg, transparent, ${glowColor}, transparent);`}
  ></div>
</article>

<style>
  .team-card {
    position: relative; overflow: hidden;
    background: rgba(33, 37, 46, 0.6);
    border: 1px solid var(--sbg-border); border-radius: 0.75rem;
    display: flex; flex-direction: column;
    width: 100%;
    transition: all 300ms ease-out;
  }
  .team-card:hover {
    background: var(--sbg-bg-surface);
    border-color: var(--sbg-accent-border);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  .team-card:focus-within { outline: 2px solid var(--sbg-accent); outline-offset: 3px; }

  .card-photo-wrapper { width: 100%; overflow: hidden; border-radius: 0.75rem 0.75rem 0 0; }
  .card-photo {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block;
    transition: transform 400ms ease-out;
  }
  .team-card:hover .card-photo { transform: scale(1.03); }
  .card-photo-placeholder {
    width: 100%; aspect-ratio: 4 / 5;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--sbg-accent), var(--sbg-orange));
    font-family: 'Space Mono', monospace; font-weight: 700; font-size: 2.5rem; color: white;
  }

  .card-info { padding: 1.25rem 1.5rem 1.5rem; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.35rem; flex-grow: 1; }
  .card-name {
    font-size: 1.1rem; font-weight: 700; margin: 0; color: #f9fafb;
    font-family: 'Space Mono', monospace; line-height: 1.3;
  }
  .card-role-badge {
    display: inline-block; font-family: 'Space Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.02em; padding: 0.3rem 0.9rem;
    border-radius: 9999px; background: var(--sbg-accent-subtle);
    color: var(--sbg-accent-light); margin-top: 0.35rem; width: fit-content;
  }
  .card-area-badge {
    display: inline-block; font-family: 'Space Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.02em; padding: 0.3rem 0.9rem;
    border-radius: 9999px; background: var(--sbg-accent-subtle);
    color: var(--sbg-accent-light); margin-top: 0.35rem; width: fit-content;
  }
  .social-links-wrapper { margin-top: auto; padding-top: 0.75rem; }
  .social-links { display: flex; gap: 0.75rem; justify-content: center; }
  .social-link {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px; padding: 0.5rem; border-radius: 0.5rem;
    color: var(--sbg-text-muted); text-decoration: none;
    transition: color 200ms ease-out, background 200ms ease-out;
  }
  .social-link:hover { color: var(--sbg-accent-light); background: rgba(139, 92, 246, 0.1); }
  .social-link--aws:hover { color: var(--sbg-orange); background: rgba(255, 153, 0, 0.12); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card { transition: none; }
    .team-card:hover { transform: none; }
    .team-card:hover .card-photo { transform: none; }
    .social-link { transition: none; }
  }
</style>
