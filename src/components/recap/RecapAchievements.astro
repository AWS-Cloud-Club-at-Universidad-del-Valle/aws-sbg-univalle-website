---
/**
 * RecapAchievements — Los 10 logros con su nivel de verificación y fuente,
 * las alianzas verificadas y los espacios reservados para fotos reales.
 */
import { LOGROS, ALIANZAS, FUENTES } from '@/lib/recap';

const nivelTexto = { oficial: 'Fuente oficial', publica: 'Fuente pública', lider: 'Confirmado por el líder' } as const;

// Espacios para fotos reales: se reemplazan cuando haya fotos con permiso de uso (ver recap/PENDIENTES.md).
const FOTOS = [
  { titulo: 'Reto Cloud Practitioner', lugar: 'Tuluá, sede Villa Campestre' },
  { titulo: 'Construye Rápido... Despliega seguro!', lugar: 'Cali, sede Meléndez' },
  { titulo: 'Escuela de Policía Simón Bolívar', lugar: 'Tuluá' },
];
---

<section id="logros" aria-labelledby="logros-heading" class="container-sbg py-14 lg:py-20">
  <span class="code-label"># logros</span>
  <h2 id="logros-heading" class="mt-3 text-3xl sm:text-4xl">Diez logros, cada uno con su fuente</h2>
  <p class="mt-3 max-w-2xl">
    Cada logro dice de dónde sale. «Confirmado por el líder» quiere decir que el dato viene del equipo y todavía no tiene una fuente pública que lo respalde.
  </p>

  <ol class="recap-logros mt-10">
    {LOGROS.map((l, i) => (
      <li class="recap-logro" data-animate>
        <span class="recap-logro__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h3 class="recap-logro__titulo">{l.titulo}</h3>
          <p class="recap-logro__detalle">{l.detalle}</p>
          <p class="recap-logro__fuente">
            <span class={`recap-nivel recap-nivel--${l.nivel}`}>{nivelTexto[l.nivel]}</span>
            {l.fuente.url ? (
              <a class="recap-link" href={l.fuente.url} target="_blank" rel="noopener noreferrer">
                {l.fuente.label}<span class="sr-only"> (abre en nueva pestaña)</span>
              </a>
            ) : (
              <span class="text-[var(--sbg-text-subtle)]">{l.fuente.label}</span>
            )}
          </p>
        </div>
      </li>
    ))}
  </ol>
</section>

<section id="alianzas" aria-labelledby="alianzas-heading" class="container-sbg py-14 lg:py-20">
  <span class="code-label"># alianzas</span>
  <h2 id="alianzas-heading" class="mt-3 text-3xl sm:text-4xl">Construimos con otros</h2>
  <p class="mt-3 max-w-2xl">Aliados con los que organizamos eventos este año, según las publicaciones de cada evento. Los nombres van en texto: no usamos logos sin permiso.</p>
  <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {ALIANZAS.map((a) => (
      <li class="recap-ally">
        <span class="recap-ally__lugar">{a.lugar}</span>
        <span class="recap-ally__nombre">{a.nombre}</span>
        <span class="recap-ally__rol">{a.rol}</span>
      </li>
    ))}
  </ul>

  <h3 class="mt-14 text-xl">En fotos</h3>
  <p class="mt-2 text-sm">Estos espacios esperan las fotos reales del equipo, con permiso de uso de las personas que aparecen.</p>
  <ul class="mt-5 grid gap-3 sm:grid-cols-3">
    {FOTOS.map((f) => (
      <li class="recap-photo" aria-label={`Espacio reservado para una foto real: ${f.titulo}`}>
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="2" /><path d="m21 17-5-5-8 8" /></svg>
        <span class="recap-photo__tag">Foto real pendiente</span>
        <span class="recap-photo__title">{f.titulo}</span>
        <span class="recap-photo__lugar">{f.lugar}</span>
      </li>
    ))}
  </ul>
  <p class="mt-4 text-xs text-[var(--sbg-text-subtle)]">
    Metodología, fuentes y conflictos entre fuentes: <a class="recap-link" href={FUENTES.repo.url} target="_blank" rel="noopener noreferrer">{FUENTES.repo.label}</a>.
  </p>
</section>
