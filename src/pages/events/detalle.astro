---
/**
 * Página /events/detalle?id=... — Detalle de un evento.
 *
 * Sitio estático (SSG): el id se lee del querystring en el cliente y se
 * consume GET /events/{id}. La descripción viene en markdown y se renderiza.
 * Los estilos viven en global.css (no scoped) porque el contenido se inyecta
 * dinámicamente por JS y no recibiría el hash del <style> scoped.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Detalle del evento"
  description="Información completa del evento del AWS Student Builder Group de la Universidad del Valle."
>
  <section class="relative overflow-hidden py-10 lg:py-14">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[45vh]"
      style="background:radial-gradient(ellipse 55% 45% at 30% 0%,rgba(255,153,0,0.07) 0%,transparent 65%);"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.02]"
      style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:36px 36px;"></div>

    <div class="container-sbg relative z-10">
      <a href="/events" class="evd-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        Volver a eventos
      </a>

      <!-- Carga -->
      <div id="detail-loading" class="evd-loading">
        <div class="skeleton-box" style="aspect-ratio:16/8;border-radius:1.25rem;"></div>
        <div class="skeleton-line skeleton-line--title" style="margin-top:1.75rem;width:55%;"></div>
        <div class="skeleton-line" style="width:35%;"></div>
        <div class="skeleton-line" style="margin-top:1.5rem;"></div>
        <div class="skeleton-line"></div>
        <div class="skeleton-line skeleton-line--short"></div>
      </div>

      <!-- Contenido (rellenado por JS) -->
      <article id="detail-content" class="evd" hidden></article>

      <!-- Error -->
      <div id="detail-error" class="events-error" hidden role="alert">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <p id="detail-error-msg">No se pudo cargar el evento.</p>
        <a href="/events" class="events-retry" style="text-decoration:none;display:inline-block;">Volver a eventos</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchEventById, EventsApiError } from '@/lib/eventsApi';
  import {
    formatApiDate,
    eventTypeLabel,
    modalityLabel,
    eventTypeColor,
  } from '@/lib/utils';
  import { marked } from 'marked';

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  /** Sanitiza el HTML generado por marked. */
  function sanitize(html: string): string {
    const tpl = document.createElement('template');
    tpl.innerHTML = html;
    const walker = document.createTreeWalker(tpl.content, NodeFilter.SHOW_ELEMENT);
    const toRemove: Element[] = [];
    let node = walker.nextNode() as Element | null;
    while (node) {
      const tag = node.tagName.toLowerCase();
      if (['script', 'iframe', 'object', 'embed', 'style'].includes(tag)) {
        toRemove.push(node);
      } else {
        [...node.attributes].forEach((attr) => {
          const name = attr.name.toLowerCase();
          const val = attr.value.trim().toLowerCase();
          if (name.startsWith('on')) node.removeAttribute(attr.name);
          if ((name === 'href' || name === 'src') && val.startsWith('javascript:')) {
            node.removeAttribute(attr.name);
          }
        });
        if (tag === 'a') {
          node.setAttribute('target', '_blank');
          node.setAttribute('rel', 'noopener noreferrer');
        }
      }
      node = walker.nextNode() as Element | null;
    }
    toRemove.forEach((el) => el.remove());
    return tpl.innerHTML;
  }

  const ICONS = {
    cal: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
    clock: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
    pin: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
    modVirtual: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
    ext: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>',
  };

  function initDetailPage() {
    const loading = document.getElementById('detail-loading');
    const content = document.getElementById('detail-content');
    const errorEl = document.getElementById('detail-error');
    const errorMsg = document.getElementById('detail-error-msg');

    if (!content || !loading || !errorEl) return;

    const id = new URLSearchParams(window.location.search).get('id');

    function showError(msg: string) {
      if (loading) loading.hidden = true;
      if (content) content.hidden = true;
      if (errorEl) errorEl.hidden = false;
      if (errorMsg) errorMsg.textContent = msg;
    }

    if (!id) {
      showError('No se especificó un evento válido.');
      return;
    }

    fetchEventById(id)
      .then((ev) => {
        if (!content) return;

        const color = eventTypeColor(ev.eventType);
        const timeText = ev.endTime
          ? `${escapeHtml(ev.startTime)} – ${escapeHtml(ev.endTime)}`
          : escapeHtml(ev.startTime ?? '');
        const modIcon = ev.modality === 'VIRTUAL' ? ICONS.modVirtual : ICONS.pin;

        const descHtml = ev.description
          ? sanitize(marked.parse(ev.description, { async: false }) as string)
          : '<p>Sin descripción disponible.</p>';

        // Hero inmersivo: imagen de fondo con overlay, badges + título encima.
        const heroBg = ev.image
          ? `<img src="${escapeHtml(ev.image)}" alt="${escapeHtml(ev.title)}" class="evd-hero-img" loading="lazy" decoding="async" />`
          : '';

        // Stat cards horizontales (consistente con las stats del inicio)
        const stats: string[] = [];
        stats.push(`
          <div class="evd-stat">
            <span class="evd-stat-icon">${ICONS.cal}</span>
            <span class="evd-stat-label"># fecha</span>
            <span class="evd-stat-value">${escapeHtml(formatApiDate(ev.date))}</span>
          </div>`);
        if (timeText) {
          stats.push(`
            <div class="evd-stat">
              <span class="evd-stat-icon">${ICONS.clock}</span>
              <span class="evd-stat-label"># hora</span>
              <span class="evd-stat-value">${timeText}</span>
              ${ev.timezone ? `<span class="evd-stat-sub">${escapeHtml(ev.timezone)}</span>` : ''}
            </div>`);
        }
        stats.push(`
          <div class="evd-stat">
            <span class="evd-stat-icon">${modIcon}</span>
            <span class="evd-stat-label"># modalidad</span>
            <span class="evd-stat-value">${escapeHtml(modalityLabel(ev.modality))}</span>
          </div>`);
        if (ev.location) {
          stats.push(`
            <div class="evd-stat evd-stat--wide">
              <span class="evd-stat-icon">${ICONS.pin}</span>
              <span class="evd-stat-label"># lugar</span>
              <span class="evd-stat-value evd-stat-value--sm">${escapeHtml(ev.location)}</span>
            </div>`);
        }

        // Descripción: solo si tiene contenido suficiente (evita mostrar texto truncado)
        const descText = (ev.description || '').trim();
        const descBlock =
          descText.length > 0
            ? `<div class="evd-desc">
                 <span class="evd-info-heading"># sobre_el_evento</span>
                 <div class="evd-body">${descHtml}</div>
               </div>`
            : '';

        const registerBlock = ev.registrationUrl
          ? `<a href="${escapeHtml(ev.registrationUrl)}" target="_blank" rel="noopener noreferrer" class="evd-register">
               Registrarme ${ICONS.ext}
             </a>`
          : '';

        const sourceBlock = ev.sourceUrl
          ? `<a href="${escapeHtml(ev.sourceUrl)}" target="_blank" rel="noopener noreferrer" class="evd-source">
               Ver en Meetup ${ICONS.ext}
             </a>`
          : '';

        content.innerHTML = `
          <div class="evd-hero">
            ${heroBg}
            <div class="evd-hero-overlay"></div>
            <div class="evd-hero-content">
              <div class="evd-badges">
                <span class="evd-badge" style="--badge-color:${color};">${escapeHtml(eventTypeLabel(ev.eventType))}</span>
                <span class="evd-badge evd-badge--muted">${escapeHtml(modalityLabel(ev.modality))}</span>
              </div>
              <h1 class="evd-title">${escapeHtml(ev.title)}</h1>
            </div>
          </div>

          <div class="evd-stats">
            ${stats.join('')}
          </div>

          <div class="evd-cta-row">
            ${registerBlock}
            ${sourceBlock}
          </div>

          ${descBlock}
        `;

        if (loading) loading.hidden = true;
        if (errorEl) errorEl.hidden = true;
        content.hidden = false;

        document.title = `${ev.title} | AWS SBG Univalle`;
      })
      .catch((err) => {
        const msg =
          err instanceof EventsApiError
            ? err.message
            : 'Ocurrió un error inesperado al cargar el evento.';
        showError(msg);
      });
  }

  document.addEventListener('astro:page-load', initDetailPage);
</script>
