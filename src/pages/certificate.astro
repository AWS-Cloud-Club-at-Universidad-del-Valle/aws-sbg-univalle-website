---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionDivider from '@/components/common/SectionDivider.astro';

const meetupUrl = 'https://www.meetup.com/aws-sbg-at-university-of-the-valley-cali/';

const certifications = [
  {
    id: 'cloud-practitioner',
    name: 'AWS Certified Cloud Practitioner',
    code: 'CLF-C02',
    tagline: 'Tu primer paso en la nube',
    description: 'Demuestra comprensión general de la nube AWS, incluyendo conceptos, servicios principales, seguridad, arquitectura, precios y soporte. La certificación más popular de AWS para comenzar tu carrera cloud.',
    color: '#FF9900',
    colorBg: 'rgba(255,153,0,0.1)',
    colorGlow: 'rgba(255,153,0,0.06)',
    duration: '90 min',
    questions: '65',
    passingScore: '700/1000',
    officialCost: '$100 USD',
    url: 'https://aws.amazon.com/certification/certified-cloud-practitioner/',
    domains: [
      { name: 'Conceptos de la nube', weight: '24%', desc: 'Propuesta de valor de AWS, modelo de responsabilidad compartida, estrategias de migración.' },
      { name: 'Seguridad y cumplimiento', weight: '30%', desc: 'IAM, cifrado, AWS Organizations, compliance frameworks, gobernanza.' },
      { name: 'Tecnología y servicios cloud', weight: '34%', desc: 'EC2, S3, RDS, Lambda, VPC, CloudFront, y más de 30 servicios clave.' },
      { name: 'Facturación, precios y soporte', weight: '12%', desc: 'Modelos de precios, AWS Free Tier, planes de soporte, Cost Explorer.' },
    ],
  },

];

const modules = [
  { number: 1, title: 'Introducción a la Nube', desc: 'Cloud computing, modelos de despliegue, ventajas de AWS.' },
  { number: 2, title: 'Cómputo en la Nube', desc: 'Amazon EC2, tipos de instancias, escalado, ELB.' },
  { number: 3, title: 'Servicios de Cómputo', desc: 'Lambda, ECS, EKS, Fargate, Elastic Beanstalk.' },
  { number: 4, title: 'Infraestructura Global', desc: 'Regiones, AZ, Edge Locations, CloudFront.' },
  { number: 5, title: 'Redes', desc: 'VPC, subredes, security groups, Route 53.' },
  { number: 6, title: 'Almacenamiento', desc: 'S3, EBS, EFS, clases de storage, lifecycle.' },
  { number: 7, title: 'Bases de Datos', desc: 'RDS, Aurora, DynamoDB, Redshift, ElastiCache.' },
  { number: 8, title: 'IA/ML y Analítica', desc: 'SageMaker, Rekognition, Athena, QuickSight.' },
  { number: 9, title: 'Seguridad', desc: 'IAM, MFA, Organizations, KMS, Shield, WAF.' },
  { number: 10, title: 'Monitoreo y Gobernanza', desc: 'CloudWatch, CloudTrail, Config, Trusted Advisor.' },
  { number: 11, title: 'Precios y Soporte', desc: 'Free Tier, pricing models, Cost Explorer.' },
  { number: 12, title: 'Migración', desc: 'Migration Hub, Snow Family, DMS, 6R strategies.' },
  { number: 13, title: 'Well-Architected', desc: '6 pilares, AWS Well-Architected Tool, best practices.' },
];
---

<BaseLayout
  title="Certifícate"
  description="Prepárate para la certificación AWS Cloud Practitioner con clases presenciales gratuitas en la Universidad del Valle."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-24 lg:py-32">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[70vh]"
      style="background:radial-gradient(ellipse 60% 50% at 50% 0%,rgba(255,153,0,0.07) 0%,transparent 65%);"></div>

    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.015]"
      style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:40px 40px;"></div>

    <div class="container-sbg relative z-10">
      <div class="max-w-3xl">
        <span class="hero-animate hero-animate-delay-1 code-label mb-4 inline-block"># programa_certificaciones</span>
        <h1 class="hero-animate hero-animate-delay-2 text-[2.6rem] leading-[1.05] tracking-tight sm:text-5xl lg:text-[3.6rem]">
          Certifícate con <span class="text-[var(--sbg-orange)]">AWS</span>
        </h1>
        <p class="hero-animate hero-animate-delay-3 mt-6 max-w-2xl text-base leading-[1.8] text-[var(--sbg-text-muted)] sm:text-lg"
          style="font-family:'Nunito Sans',sans-serif;">
          Te preparamos para las certificaciones oficiales de Amazon Web Services con clases presenciales
          basadas en el contenido del AWS Skill Builder. Material actualizado, directo de Amazon.
        </p>
      </div>

      <!-- Highlight banner: FREE -->
      <div class="hero-animate hero-animate-delay-4 mt-10 max-w-2xl rounded-2xl border border-[var(--sbg-orange)]/20 bg-gradient-to-r from-[var(--sbg-orange)]/5 to-transparent p-5 sm:p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--sbg-orange)]/15 text-[var(--sbg-orange)]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-bold text-white" style="font-family:'Space Mono',monospace;">
              Examen 100% gratis para nuestros miembros
            </p>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
              AWS nos apoya con vouchers para que presentes el examen de certificación sin costo.
              Las clases, la preparación y el examen oficial son completamente gratuitos si haces parte de nuestro grupo.
            </p>
          </div>
        </div>
      </div>

      <!-- Requirements -->
      <div class="hero-animate hero-animate-delay-5 mt-8 flex flex-wrap items-center gap-2.5">
        {[
          { text: 'Estudiante de Univalle' },
          { text: 'Inscrito en nuestro Meetup' },
          { text: 'Clases presenciales' },
          { text: 'Examen gratis' },
        ].map((pill) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] px-4 py-2 text-xs font-semibold text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--sbg-orange)" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {pill.text}
          </span>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Certifications -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="container-sbg relative z-10">
      <div class="mb-12" data-animate>
        <span class="code-label mb-3 inline-block"># certificaciones_foundational</span>
        <h2 class="text-[2rem] leading-[1.1] sm:text-[2.6rem]">
          Elige tu <span class="text-[var(--sbg-orange)]">certificación</span>
        </h2>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
          Selecciona una certificación para explorar los dominios del examen y lo que aprenderás.
        </p>
      </div>

      <div class="space-y-5">
        {certifications.map((cert, idx) => (
          <details
            data-animate
            class="cert-details group rounded-2xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] transition-all duration-500 open:border-transparent open:shadow-2xl"
            style={`transition-delay: ${idx * 100}ms; --cert-color: ${cert.color}; --cert-bg: ${cert.colorBg};`}
          >
            <summary class="flex cursor-pointer items-center gap-5 p-6 sm:p-8 select-none list-none [&::-webkit-details-marker]:hidden">
              <!-- Badge -->
              <div class="relative flex h-16 w-16 sm:h-20 sm:w-20 shrink-0 items-center justify-center rounded-2xl transition-all duration-500 group-hover:scale-105 group-open:scale-110"
                   style={`background: ${cert.colorBg}; box-shadow: 0 0 0 1px ${cert.color}25;`}>
                <!-- AWS-style certification badge SVG -->
                <svg width="40" height="40" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <!-- Outer hexagonal shape -->
                  <path d="M24 4L40 13V35L24 44L8 35V13L24 4Z" stroke={cert.color} stroke-width="1.5" fill="none" opacity="0.3"/>
                  <!-- Inner shield -->
                  <path d="M24 10L36 16V32L24 38L12 32V16L24 10Z" stroke={cert.color} stroke-width="1.2" fill={cert.colorBg}/>
                  <!-- Center medal -->
                  <circle cx="24" cy="22" r="6" stroke={cert.color} stroke-width="1.5" fill="none"/>
                  <circle cx="24" cy="22" r="2.5" fill={cert.color} opacity="0.5"/>
                  <!-- Ribbon -->
                  <path d="M20 28L22 34L24 32L26 34L28 28" stroke={cert.color} stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                  <!-- Star on top -->
                  <path d="M24 14L25.2 16.5L28 16.9L26 18.8L26.4 21.6L24 20.3L21.6 21.6L22 18.8L20 16.9L22.8 16.5L24 14Z" fill={cert.color} opacity="0.7"/>
                </svg>
                <!-- Animated ring on open -->
                <div class="absolute inset-[-3px] rounded-[18px] border border-dashed opacity-0 group-open:opacity-40 transition-opacity duration-700 animate-[spin_20s_linear_infinite]" style={`border-color: ${cert.color};`}></div>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <span class="text-[10px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-md" style={`background: ${cert.colorBg}; color: ${cert.color}; font-family:'Space Mono',monospace;`}>
                    {cert.code}
                  </span>
                  <span class="text-[10px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-md bg-[var(--sbg-bg-elevated)] text-[var(--sbg-text-muted)]" style="font-family:'Space Mono',monospace;">
                    Foundational
                  </span>
                  <span class="text-[10px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-md bg-green-500/10 text-green-400" style="font-family:'Space Mono',monospace;">
                    Gratis con SBG
                  </span>
                </div>
                <h3 class="text-base sm:text-xl font-bold text-white" style="font-family:'Space Mono',monospace;">
                  {cert.name}
                </h3>
                <p class="mt-1.5 text-sm text-[var(--sbg-text-muted)] hidden sm:block" style="font-family:'Nunito Sans',sans-serif;">
                  {cert.tagline}
                </p>
              </div>

              <!-- Expand -->
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--sbg-bg-elevated)] border border-[var(--sbg-border)] transition-all duration-300 group-hover:border-[var(--sbg-orange)]/20 group-open:rotate-180 group-open:border-transparent" style="group-open:background: var(--cert-bg);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" class="text-[var(--sbg-text-muted)] group-open:text-[var(--sbg-orange)] transition-colors">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </div>
            </summary>

            <!-- Expanded content -->
            <div class="border-t border-[var(--sbg-border)] px-6 pb-8 pt-8 sm:px-8">
              <!-- Exam stats -->
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 mb-8">
                {[
                  { label: 'Duración', value: cert.duration },
                  { label: 'Preguntas', value: cert.questions },
                  { label: 'Aprobación', value: cert.passingScore },
                  { label: 'Costo oficial', value: cert.officialCost },
                ].map((detail) => (
                  <div class="rounded-xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-elevated)]/50 p-4 text-center transition-all duration-200 hover:border-[var(--sbg-accent-border)]">
                    <p class="text-[10px] text-[var(--sbg-text-muted)] uppercase tracking-wider mb-1" style="font-family:'Space Mono',monospace;">{detail.label}</p>
                    <p class="text-sm font-bold text-white" style="font-family:'Space Mono',monospace;">{detail.value}</p>
                  </div>
                ))}
              </div>

              <!-- Free badge callout -->
              <div class="mb-8 rounded-xl border border-green-500/20 bg-green-500/5 p-4 flex items-center gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-green-500/15 text-green-400">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold text-green-400" style="font-family:'Space Mono',monospace;">$0 para miembros del SBG Univalle</p>
                  <p class="text-[11px] text-[var(--sbg-text-muted)] mt-0.5" style="font-family:'Nunito Sans',sans-serif;">AWS nos patrocina los vouchers del examen. Tú solo tienes que estudiar.</p>
                </div>
              </div>

              <!-- Description -->
              <p class="text-sm leading-relaxed text-[var(--sbg-text-muted)] mb-8" style="font-family:'Nunito Sans',sans-serif;">
                {cert.description}
              </p>

              <!-- Domains -->
              <h4 class="text-[11px] font-bold text-[var(--sbg-text-muted)] uppercase tracking-[0.15em] mb-5" style="font-family:'Space Mono',monospace;">
                Dominios del examen
              </h4>
              <div class="space-y-3">
                {cert.domains.map((domain) => (
                  <div class="cert-domain rounded-xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-elevated)]/30 p-5 transition-all duration-200 hover:border-[var(--sbg-accent-border)] hover:bg-[var(--sbg-bg-elevated)]">
                    <div class="flex items-center justify-between mb-2">
                      <h5 class="text-[13px] font-bold text-white" style="font-family:'Space Mono',monospace;">{domain.name}</h5>
                      <span class="text-[11px] font-bold px-2.5 py-1 rounded-lg" style={`background: ${cert.colorBg}; color: ${cert.color}; font-family:'Space Mono',monospace;`}>
                        {domain.weight}
                      </span>
                    </div>
                    <p class="text-xs leading-relaxed text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
                      {domain.desc}
                    </p>
                    <div class="mt-3 h-1.5 w-full rounded-full bg-[var(--sbg-bg-overlay)] overflow-hidden">
                      <div class="h-full rounded-full transition-all duration-1000 ease-out" style={`width: ${domain.weight}; background: linear-gradient(90deg, ${cert.color}, ${cert.color}90);`}></div>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Official link -->
              <div class="mt-8 flex items-center gap-4">
                <a href={cert.url} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-elevated)] px-5 py-2.5 text-xs font-bold text-[var(--sbg-text-muted)] transition-all duration-200 hover:border-[var(--sbg-orange)]/30 hover:text-white hover:shadow-md" style="font-family:'Space Mono',monospace;">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                  Página oficial en AWS
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Modules / Skill Builder -->
  <section class="relative py-20 lg:py-28 overflow-hidden">


    <div class="container-sbg relative z-10">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-12" data-animate>
        <div>
          <span class="code-label mb-3 inline-block"># plan_de_estudio</span>
          <h2 class="text-[2rem] leading-[1.1] sm:text-[2.6rem]">
            Módulos del <span class="text-[var(--sbg-accent-light)]">Skill Builder</span>
          </h2>
          <p class="mt-3 max-w-lg text-base leading-relaxed text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
            Seguimos el curso oficial <strong class="text-white">AWS Cloud Practitioner Essentials</strong> (2025). Cada módulo se cubre en sesiones presenciales con práctica.
          </p>
        </div>
        <a href="https://skillbuilder.aws/" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] px-5 py-3 text-xs font-bold text-[var(--sbg-text-muted)] transition-all duration-200 hover:border-[var(--sbg-orange)]/30 hover:text-white hover:shadow-md shrink-0" style="font-family:'Space Mono',monospace;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          AWS Skill Builder
        </a>
      </div>

      <!-- Modules grid -->
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {modules.map((mod, i) => (
          <div
            data-animate
            class="module-card group relative flex items-start gap-4 rounded-xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)]/50 p-5 transition-all duration-300 hover:border-[var(--sbg-orange)]/25 hover:bg-[var(--sbg-bg-surface)] hover:shadow-xl hover:-translate-y-0.5"
            style={`transition-delay: ${i * 35}ms;`}
          >
            <!-- Cursor glow -->
            <div aria-hidden="true" class="module-glow pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-500"></div>

            <!-- Number -->
            <div class="relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--sbg-bg-elevated)] border border-[var(--sbg-border)] transition-all duration-300 group-hover:bg-gradient-to-br group-hover:from-[var(--sbg-orange)]/15 group-hover:to-[var(--sbg-accent)]/10 group-hover:border-[var(--sbg-orange)]/25 group-hover:shadow-lg group-hover:shadow-[var(--sbg-orange)]/10">
              <span class="text-xs font-bold text-[var(--sbg-text-muted)] group-hover:text-[var(--sbg-orange)] transition-colors duration-300" style="font-family:'Space Mono',monospace;">
                {mod.number.toString().padStart(2, '0')}
              </span>
            </div>

            <!-- Content -->
            <div class="relative z-10 flex-1 min-w-0">
              <h3 class="text-[13px] font-bold text-white leading-tight" style="font-family:'Space Mono',monospace;">
                {mod.title}
              </h3>
              <p class="mt-1.5 text-[11px] leading-relaxed text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
                {mod.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- 13 modules note -->
      <div data-animate class="mt-8 text-center">
        <p class="text-xs text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
          13 módulos · ~26 horas de contenido · Sesiones semanales presenciales
        </p>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- CTA -->
  <section class="relative py-20 lg:py-28 overflow-hidden">
    <div class="container-sbg relative z-10">
      <div data-animate class="cert-cta relative mx-auto max-w-2xl rounded-3xl border border-[var(--sbg-border)] bg-[var(--sbg-bg-surface)] p-10 text-center transition-all duration-500 hover:border-[var(--sbg-orange)]/20 hover:shadow-2xl sm:p-14">
        <!-- Cursor glow -->
        <div aria-hidden="true" class="cert-cta-glow pointer-events-none absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-500"></div>

        <!-- Icon -->
        <div class="relative z-10 mb-6 inline-flex h-18 w-18 items-center justify-center rounded-2xl bg-gradient-to-br from-[var(--sbg-orange)] to-[var(--sbg-accent)] shadow-2xl shadow-[var(--sbg-orange)]/20">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="7"/>
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
          </svg>
        </div>

        <h2 class="relative z-10 text-[1.8rem] leading-[1.1] sm:text-[2.2rem]">
          ¿Listo para <span class="text-[var(--sbg-orange)]">certificarte</span>?
        </h2>
        <p class="relative z-10 mt-4 text-sm leading-relaxed text-[var(--sbg-text-muted)] max-w-md mx-auto" style="font-family:'Nunito Sans',sans-serif;">
          Solo necesitas estar inscrito en nuestro Meetup. Publicamos las fechas de cada sesión ahí.
          Las clases y el examen son gratuitos gracias al apoyo de AWS.
        </p>

        <div class="relative z-10 mt-9">
          <a href={meetupUrl} target="_blank" rel="noopener noreferrer"
            class="group relative inline-flex min-h-[56px] items-center gap-3 rounded-2xl bg-gradient-to-r from-[var(--sbg-orange)] to-[var(--sbg-accent)] px-10 py-4 text-[0.95rem] font-bold text-white shadow-xl shadow-[var(--sbg-orange)]/25 transition-all duration-300 hover:shadow-2xl hover:shadow-[var(--sbg-orange)]/40 hover:-translate-y-1 hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4"
            style="font-family:'Space Mono',monospace;">
            <span aria-hidden="true" class="absolute inset-0 rounded-2xl bg-gradient-to-r from-transparent via-white/15 to-transparent -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="relative z-10">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <line x1="19" y1="8" x2="19" y2="14"/>
              <line x1="22" y1="11" x2="16" y2="11"/>
            </svg>
            <span class="relative z-10">Inscribirme en Meetup</span>
          </a>
        </div>

        <p class="relative z-10 mt-6 text-[11px] text-[var(--sbg-text-muted)]" style="font-family:'Nunito Sans',sans-serif;">
          Sin costo · Sin entrevista · Solo un clic
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
document.addEventListener('astro:page-load', function() {
  // Module card glow
  var cards = document.querySelectorAll('.module-card');
  cards.forEach(function(card) {
    var glow = card.querySelector('.module-glow');
    if (!glow) return;
    card.addEventListener('mousemove', function(e) {
      var rect = card.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      glow.style.background = 'radial-gradient(200px circle at ' + x + 'px ' + y + 'px, rgba(255,153,0,0.07) 0%, transparent 70%)';
      glow.style.opacity = '1';
    });
    card.addEventListener('mouseleave', function() { glow.style.opacity = '0'; });
  });

  // CTA glow
  var cta = document.querySelector('.cert-cta');
  if (cta) {
    var ctaGlow = cta.querySelector('.cert-cta-glow');
    if (ctaGlow) {
      cta.addEventListener('mousemove', function(e) {
        var rect = cta.getBoundingClientRect();
        var x = e.clientX - rect.left;
        var y = e.clientY - rect.top;
        ctaGlow.style.background = 'radial-gradient(400px circle at ' + x + 'px ' + y + 'px, rgba(255,153,0,0.06) 0%, rgba(139,92,246,0.03) 50%, transparent 70%)';
        ctaGlow.style.opacity = '1';
      });
      cta.addEventListener('mouseleave', function() { ctaGlow.style.opacity = '0'; });
    }
  }

  // Cert details border glow on open
  var details = document.querySelectorAll('.cert-details');
  details.forEach(function(det) {
    det.addEventListener('toggle', function() {
      var color = getComputedStyle(det).getPropertyValue('--cert-color').trim();
      var bg = getComputedStyle(det).getPropertyValue('--cert-bg').trim();
      if (det.open) {
        det.style.borderColor = color + '40';
        det.style.boxShadow = '0 0 60px ' + bg + ', 0 25px 50px -12px rgba(0,0,0,0.3)';
      } else {
        det.style.borderColor = '';
        det.style.boxShadow = '';
      }
    });
  });
});
</script>
