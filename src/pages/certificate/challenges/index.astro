---
/**
 * /certificate/challenges — Hub de retos prácticos AWS CDK.
 * Lista los 8 retos con hero, flujo de trabajo y grid de tarjetas.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionDivider from '@/components/common/SectionDivider.astro';

const challenges = (await getCollection('challenges')).sort(
  (a, b) => a.data.order - b.data.order
);

function formatSessionDate(dateStr: string): string {
  const [year, month, day] = dateStr.split('-').map(Number);
  const date = new Date(year, month - 1, day);
  return date.toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' });
}

const flowSteps = [
  {
    label: 'Entiende',
    desc: 'Lee el contexto y el objetivo del reto.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
  },
  {
    label: 'Diseña',
    desc: 'Diagrama la arquitectura antes de escribir código.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
  },
  {
    label: 'Construye',
    desc: 'Implementa la infraestructura con AWS CDK.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    label: 'Despliega',
    desc: 'Ejecuta cdk deploy y verifica los recursos.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  },
  {
    label: 'Prueba',
    desc: 'Valida que cumple los criterios de éxito.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
  },
  {
    label: 'Resuelve',
    desc: 'Enfrenta el Boss Fight y ejecuta cdk destroy.',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  },
];
---

<BaseLayout
  title="Retos AWS CDK"
  description="AWS Cloud Practitioner Challenges: aprende cloud construyendo 8 proyectos reales con AWS CDK en la Universidad del Valle."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-20 lg:py-28">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-[65vh]"
      style="background:radial-gradient(ellipse 60% 50% at 40% 0%,rgba(139,92,246,0.09) 0%,transparent 65%);"></div>
    <div aria-hidden="true" class="pointer-events-none absolute bottom-0 right-0 h-[45vh] w-[45vw]"
      style="background:radial-gradient(ellipse at 80% 100%,rgba(255,153,0,0.06) 0%,transparent 60%);"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.015]"
      style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:40px 40px;"></div>

    <div class="container-sbg relative z-10">
      <nav aria-label="Breadcrumb" class="ch-breadcrumb mb-8">
        <ol class="ch-breadcrumb__list">
          <li><a href="/certificate" class="ch-breadcrumb__link">Certifícate</a><span class="ch-breadcrumb__sep">›</span></li>
          <li aria-current="page" class="ch-breadcrumb__current">Retos AWS CDK</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <span class="hero-animate hero-animate-delay-1 code-label mb-4 inline-block"># retos_practicos_cdk</span>
        <h1 class="hero-animate hero-animate-delay-2 text-[2.4rem] leading-[1.07] tracking-tight sm:text-5xl lg:text-[3.4rem]">
          Aprende Cloud<br/>
          <span class="text-[var(--sbg-orange)]">construyendo</span> con AWS CDK
        </h1>
        <p class="hero-animate hero-animate-delay-3 mt-5 max-w-2xl text-base leading-[1.8] text-[var(--sbg-text-muted)] sm:text-lg"
          style="font-family:'Nunito Sans',sans-serif;">
          8 proyectos reales del AWS Cloud Practitioner. Diseña, despliega con CDK
          y enfrenta el <strong class="text-white">Boss Fight</strong> de cada reto.
        </p>
        <div class="hero-animate hero-animate-delay-4 mt-8 flex flex-wrap gap-6">
          {[
            { value: '8', label: 'retos' },
            { value: 'CDK', label: 'infraestructura como código' },
            { value: '100%', label: 'gratuito' },
          ].map(({ value, label }) => (
            <div class="flex flex-col gap-0.5">
              <span class="text-2xl font-bold text-white leading-none" style="font-family:'Space Mono',monospace;">{value}</span>
              <span class="text-[11px] text-[var(--sbg-text-subtle)] uppercase tracking-widest" style="font-family:'Nunito Sans',sans-serif;">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Flujo de trabajo -->
  <section class="relative py-16 lg:py-20">
    <div class="container-sbg">
      <div class="mb-10" data-animate>
        <span class="code-label mb-3 inline-block"># como_funciona</span>
        <h2 class="text-[1.9rem] leading-[1.1] sm:text-[2.4rem]">El flujo de cada reto</h2>
      </div>
      <div class="ch-flow" data-animate>
        {flowSteps.map((step, i) => (
          <div class="ch-flow__step">
            <div class="ch-flow__icon" set:html={step.icon} />
            <div class="ch-flow__content">
              <span class="ch-flow__label">{step.label}</span>
              <span class="ch-flow__desc">{step.desc}</span>
            </div>
            {i < flowSteps.length - 1 && (
              <div class="ch-flow__arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Grid de retos -->
  <section class="relative py-16 lg:py-24">
    <div class="container-sbg">
      <div class="mb-10" data-animate>
        <span class="code-label mb-3 inline-block"># los_8_retos</span>
        <h2 class="text-[1.9rem] leading-[1.1] sm:text-[2.4rem]">
          Elige tu <span class="text-[var(--sbg-accent-light)]">próximo reto</span>
        </h2>
      </div>

      <div class="ch-grid">
        {challenges.map((ch, i) => {
          const diffColor =
            ch.data.difficulty === 'Básico' ? 'var(--sbg-accent-light)' :
            ch.data.difficulty === 'Avanzado' ? '#f87171' : 'var(--sbg-orange)';
          return (
            <a href={`/certificate/challenges/${ch.data.slug}`} class="ch-card group">
              <div aria-hidden="true" class="ch-card__glow"></div>
              <div class="ch-card__header">
                <span class="ch-card__number">{ch.data.challengeId.toString().padStart(2, '0')}</span>
                <span class="ch-card__difficulty" style={`color:${diffColor};`}>{ch.data.difficulty}</span>
              </div>
              <h3 class="ch-card__title">{ch.data.title}</h3>
              <p class="ch-card__desc">{ch.data.description}</p>
              <div class="ch-card__footer">
                <span class="ch-card__duration">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  {formatSessionDate(ch.data.sessionDate)}
                </span>
                <div class="ch-card__services">
                  {ch.data.services.slice(0, 4).map((s: string) => (
                    <span class="ch-service-badge">{s}</span>
                  ))}
                  {ch.data.services.length > 4 && (
                    <span class="ch-service-badge ch-service-badge--more">+{ch.data.services.length - 4}</span>
                  )}
                </div>
              </div>
              <span class="ch-card__cta" aria-hidden="true">
                Ver reto
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
document.addEventListener('astro:page-load', function () {
  document.querySelectorAll('.ch-card').forEach(function (card) {
    var glow = card.querySelector('.ch-card__glow');
    if (!glow) return;
    card.addEventListener('mousemove', function (e) {
      var rect = card.getBoundingClientRect();
      glow.style.background = 'radial-gradient(320px circle at ' + (e.clientX - rect.left) + 'px ' + (e.clientY - rect.top) + 'px, rgba(255,153,0,0.07) 0%, transparent 70%)';
      glow.style.opacity = '1';
    });
    card.addEventListener('mouseleave', function () { glow.style.opacity = '0'; });
  });
});
</script>
